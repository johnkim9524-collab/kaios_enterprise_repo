{
  "version": "1.2.0",
  "status": "P0_PRE_INGESTION_CONTROL",
  "governing_issue": 881,
  "rule": "NO_PARTNER_DATA_INGESTION_BEFORE_PRE_INTAKE_GATE_PASS",
  "purpose": "Unify distributed audit controls into an append-only, fail-closed audit control plane before external partner data ingestion.",
