    "FAIL_CLOSED",
    "EVIDENCE_BEFORE_METRICS",
    "RIGHTS_BEFORE_USE",
    "QUARANTINE_BEFORE_PROMOTION",
    "NO_PROVIDER_EQUALS_TRUTH",
