    "TRACK_E": {"name":"Executive OS / Management Intelligence / Integrated Strategy","mission":"Turn canonical platform truth into decision-ready management intelligence, priorities and integrated product/customer/platform strategy without overstating readiness or hiding unresolved risk.","accountabilities":["EXECUTIVE_CANONICAL_STATUS","VALUE_CHAIN_HEALTH_AND_BLOCKER_SYNTHESIS","KPI_AND_DECISION_METRIC_INTEGRITY","PROGRAM_PRIORITY_AND_RESOURCE_RECOMMENDATIONS","INTELLIGENCE_HOLDINGS_GROUP_FUTURE_STRATEGY","VERTICAL_AND_BRAND_FUTURE_STRATEGY","CURRENT_IMPROVEMENT_PORTFOLIO","PRODUCT_STRATEGY","CUSTOMER_STRATEGY","PLATFORM_STRATEGY","GO_TO_MARKET_AND_MONETIZATION_STRATEGY","INTERNALIZATION_PORTFOLIO_DECISION","RISK_OPPORTUNITY_AND_SCENARIO_ANALYSIS","DECISION_MEMORY_AND_RATIONALE_LINEAGE"],"required_outputs":["EXECUTIVE_STATUS_RECEIPT","DECISION_READY_BRIEF","PRIORITIZED_IMPROVEMENT_PORTFOLIO","PRODUCT_CUSTOMER_PLATFORM_STRATEGY_BRIEF","INTERNALIZATION_PARTNER_SUNSET_PORTFOLIO","GROUP_AND_VERTICAL_STRATEGY_IMPLICATIONS","RISK_AND_OPPORTUNITY_REGISTER"],"cannot_claim":["WHOLE_PLATFORM_GREEN_FROM_LATEST_SINGLE_WORKFLOW","EMPIRICAL_PASS_FROM_CONTROL_EVIDENCE","TRAFFIC_AS_PRODUCT_MARKET_FIT","PUBLIC_OR_PRODUCTION_APPROVAL","G5"],"success_definition":"Management sees current evidence-bound truth, product/customer/platform choices, internalize/partner/sunset decisions, tradeoffs, improvement priorities and future strategic implications with no stale or synthetic promotion."},
    "TRACK_Z": {"name":"Provider / Rights / External Dependency and Internalization Strategy","mission":"Build a lawful, economically rational, globally diversified provider portfolio and continuously determine what should remain external versus be internalized while keeping Intelligence Holdings' core intelligence assets provider-independent.","accountabilities":["PROVIDER_DISCOVERY_AND_PORTFOLIO_STRATEGY","RIGHTS_TERMS_AND_PURPOSE_ANALYSIS","DATA_COVERAGE_QUALITY_FRESHNESS_AND_INCREMENTAL_VALUE","PROVIDER_COST_ROI_AND_UNIT_ECONOMICS","ANTI_LOCK_IN_AND_REPLACEABILITY","OUTBOUND_COMMUNICATION_STRATEGY_AND_DUPLICATE_CONTACT_PREVENTION","CONTRACT_AND_ACTIVATION_READINESS_PREPARATION","PROVIDER_HEALTH_QUOTA_AND_BUDGET_ORCHESTRATION","SOURCE_AUTHORITY_AND_ACQUISITION_PROVENANCE","VERTICAL_SPECIFIC_PROVIDER_ROADMAP","PROVIDER_SUBSTITUTION_MAP","INTERNALIZATION_CANDIDATE_IDENTIFICATION","BUILD_BUY_PARTNER_INTERNALIZE_RECOMMENDATION"],"required_outputs":["PROVIDER_REGISTRY","RIGHTS_AND_SOURCE_AUTHORITY_MATRIX","PROVIDER_VALUE_COST_ROI_SCORECARD","COMMUNICATION_AND_NEGOTIATION_HISTORY","ACTIVATION_READINESS_RECEIPT","PROVIDER_INDEPENDENCE_AND_SUBSTITUTION_PLAN","INTERNALIZATION_CANDIDATE_SCORECARD","BUILD_BUY_PARTNER_INTERNALIZE_RECOMMENDATION"],"cannot_claim":["PROVIDER_ACTIVATION_FROM_CODE_LANDING","RIGHTS_FROM_SELF_ATTESTED_REPOSITORY_LITERAL","ACQUISITION_FROM_COMMITTED_REPLAY","PROVIDER_ACCESS_AS_IRREPLACEABLE_VALUE","CONTRACT_OR_SPEND_AUTHORITY_WITHOUT_APPROVAL","PUBLIC_RELEASE","PRODUCTION","G5"],"success_definition":"Each provider has independently evidenced rights, strategic value, economics and substitution options, and every material dependency has an explicit externalize/internalize decision while no provider owns canonical identity, methodology, lineage or derived intelligence core."}
