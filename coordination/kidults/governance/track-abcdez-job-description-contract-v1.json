  "tracks": {
    "TRACK_A": {"name":"Intelligence Factory / Candidate-Evidence Formation","mission":"Convert lawful source observations into canonical, provenance-bound Candidate and Evidence inputs without fabricating empirical authority.","accountabilities":["GLOBAL_SOURCE_DISCOVERY_AND_OBSERVATION_INGRESS","SOURCE_AND_OBJECT_IDENTITY_NORMALIZATION","RIGHTS_AND_PURPOSE_BOUNDARY_PRESERVATION","OBSERVATION_TO_CANDIDATE_TRANSFORMATION","IMMUTABLE_EVIDENCE_PACKAGE_FORMATION","DATA_QUALITY_FRESHNESS_DUPLICATE_OUTLIER_AND_CARDINALITY_CONTROLS","ROW_LEVEL_AND_OBJECT_LEVEL_PROVENANCE","EMPIRICAL_VS_CONTROL_ONLY_CLASSIFICATION","PRODUCT_EVIDENCE_FEASIBILITY","SOURCE_TO_PRODUCT_FEEDBACK","HANDOFF_TO_TRACK_B"],"required_outputs":["snapshot-candidate.json_OR_VERSIONED_SUCCESSOR","EVIDENCE_PACKAGE","SOURCE_RIGHTS_PROVENANCE_RECEIPTS","CANDIDATE_EVIDENCE_PAIR_DIGEST","PRODUCT_EVIDENCE_FEASIBILITY_SIGNAL","TRACK_B_HANDOFF_RECEIPT"],"cannot_claim":["OFFICIAL_TRACK_B_PASS","APPROVED_PROJECTION","PUBLIC_RELEASE","PRODUCTION","G5"],"success_definition":"Exactly one immutable Candidate/Evidence lineage is lawful, current, reproducible, product-relevant and independently consumable by Track B, while remaining non-promotable until downstream gates pass."},
    "TRACK_B": {"name":"Rankability / Independent Intelligence Validation","mission":"Independently test whether Track A evidence is sufficient, representative, rankable and decision-useful before any projection or publication authority exists.","accountabilities":["INDEPENDENT_CANDIDATE_EVIDENCE_INPUT_VERIFICATION","RANKABILITY_AND_REPRESENTATIVENESS_ASSESSMENT","METHODOLOGY_AND_SAMPLE_BOUNDARY_ENFORCEMENT","CONFIDENCE_AND_UNCERTAINTY_CLASSIFICATION","BIAS_COVERAGE_AND_SENSITIVITY_REVIEW","PRODUCT_CLAIM_SAFETY","CUSTOMER_DECISION_UTILITY_VALIDATION","METHODOLOGY_DIFFERENTIATION","BLOCKED_CONDITIONAL_PASS_SEMANTIC_INTEGRITY","NO_PROMOTION_WHEN_CANONICAL_PAIR_ABSENT","HANDOFF_TO_APPROVED_PROJECTION_PROCESS"],"required_outputs":["rankability-assessment.json_OR_VERSIONED_SUCCESSOR","INPUT_PAIR_PROVENANCE_BINDING","METHODOLOGY_AND_CONFIDENCE_RECEIPT","PRODUCT_CLAIM_SAFETY_RECEIPT","DECISION_UTILITY_ASSESSMENT","BLOCKER_AND_LIMITATION_REGISTER","PROJECTION_ELIGIBILITY_DECISION_RECEIPT"],"cannot_claim":["PUBLIC_RELEASE_FROM_INTERNAL_ASSESSMENT_ALONE","PRODUCTION","G5","EMPIRICAL_INPUT_NOT_PROVEN_BY_TRACK_A"],"success_definition":"A specific immutable Track A pair receives an independently reproducible rankability and customer-decision-utility decision whose limitations and promotion ceiling are machine-readable."},
    "TRACK_C": {"name":"Portal / Experience / Intelligence Consumption","mission":"Deliver approved intelligence through coherent global customer experiences while preventing the Portal from manufacturing or recalculating intelligence authority.","accountabilities":["PORTAL_AND_WORKSPACE_EXPERIENCE","APPROVED_PROJECTION_ONLY_CONSUMPTION","DESKTOP_MOBILE_RESPONSIVE_PARITY","ACCESSIBILITY_AND_BROWSER_LIFECYCLE_QUALITY","API_EXPORT_AND_RENDER_AUTHORITY_BOUNDARIES","STALE_VALUE_AND_FAILURE_CONTAINMENT","PERFORMANCE_NAVIGATION_AND_USABILITY","USER_VISIBLE_PROVENANCE_AND_LIMITATION_TRANSPARENCY","CUSTOMER_SEGMENT_EXPERIENCE","PRODUCT_PACKAGING_SURFACE","ADOPTION_USAGE_AND_RETENTION_FEEDBACK"],"required_outputs":["PORTAL_ACCEPTANCE_RECEIPT","APPROVED_PROJECTION_BINDING","BROWSER_AND_ACCESSIBILITY_EVIDENCE","CUSTOMER_USAGE_AND_EXPERIENCE_SIGNAL","PRODUCT_PACKAGING_FEEDBACK","FAIL_CLOSED_RENDER_API_EXPORT_RECEIPTS"],"cannot_claim":["PORTAL_CALCULATION_AS_CANONICAL_INTELLIGENCE","TRAFFIC_AS_PRODUCT_MARKET_FIT","PUBLIC_RELEASE_WITHOUT_SEPARATE_AUTHORITY","PRODUCTION","G5"],"success_definition":"The canonical shared Portal consumes only governed intelligence, serves segment-appropriate product experiences, captures adoption/retention feedback, and exposes evidence state without creating new analytical authority."},
