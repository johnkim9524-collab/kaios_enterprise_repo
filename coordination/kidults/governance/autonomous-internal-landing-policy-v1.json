{
  "id": "kidults-autonomous-internal-landing-policy-v1",
  "version": "1.6.0",
  "status": "MANDATORY_FAIL_CLOSED",
  "authority": "AI-020_DELEGATED_AUTONOMOUS_INTERNAL_AUTHORITY",
  "normal_path": "AUTONOMOUS",
  "manual_owner_path": "RECOVERY_ONLY",
  "delegated_operation": "INTERNAL_REVERSIBLE_LANDING",
  "approval_policy_envelope": "kidults-autonomous-approval-policy-envelope-v1",
  "state_model": [
    "SCOPE_GRANTED",
    "KPMO_AUTHORIZED",
    "TRACK_AUTHORIZED",
    "INDEPENDENT_VERIFIED",
    "LANDING_RESERVED",
    "MERGED_EVENT_EMITTED",
    "TARGET_REVALIDATED",
    "RECEIPT_SEALED"
  ],
  "terminal_failure_states": [
    "DENIED",
    "EXPIRED",
    "DRIFTED",
    "QUARANTINED",
    "MERGED_QUARANTINED",
    "OWNER_HOLD"
  ],
  "approval_quorum": {
    "minimum": 2,
    "required_roles": [
      "ACCOUNTABLE_TRACK_AGENT",
      "KPMO"
    ],
    "independent_verifier_distinct_from_approvers": true,
    "self_approval_forbidden": true,
    "identity_model": "ROLE_SCOPED_OIDC_KMS_WORKLOAD_V2_FINALIZER_SPLIT",
    "distinct_stable_workload_ids_required": true,
    "distinct_signing_keys_required": true,
    "approval_workloads_may_finalize": false,
    "finalizer_distinct_from_approvers": true
  },
  "exact_binding_fields": [
    "repository_id",
    "repository",
    "pull_request",
    "base_sha",
    "head_sha",
    "head_tree_sha",
    "scope_digest",
    "test_evidence_digest",
    "rollback_digest",
    "authorization_generation",
    "nonce_digest",
    "issued_at",
    "expires_at"
  ],
  "eligible_all_required": [
    "REPOSITORY_INTERNAL",
    "REVERSIBLE",
    "ROLLBACK_BOUND",
    "NO_EXTERNAL_SIDE_EFFECT",
    "NO_OWNER_RESERVED_PATH",
    "REQUIRED_CHECKS_GREEN",
    "HEAD_TREE_SCOPE_STABLE",
    "TRACK_AND_KPMO_QUORUM",
    "INDEPENDENT_VERIFIER_PASS",
    "DURABLE_NONCE_RESERVATION_PASS"
  ],
  "owner_reserved_actions": [
    "PRODUCTION",
    "PUBLIC",
    "G5",
    "EXTERNAL_COMMUNICATION",
    "EXTERNAL_SPEND",
    "CONTRACTUAL_COMMITMENT",
    "LEGAL_POLICY_EXCEPTION",
    "IRREVERSIBLE_SECURITY_CHANGE",
    "CREDENTIAL_OR_PERMISSION_EXPANSION",
    "SECRET_CREATE_READ_ROTATE_EXPORT",
    "TRUST_ROOT_OR_RULESET_WEAKENING",
    "DESTRUCTIVE_DATA_OPERATION",
    "PROTECTED_PROMOTION_OR_RELEASE"
  ],
  "owner_reserved_path_prefixes": [
    ".github/workflows/",
    "coordination/kidults/governance/",
    "scripts/kidults/kpmo/",
    "secrets/",
    "production/",
    "public/",
    "g5/"
  ],
  "delegated_internal_exact_path_exceptions": [
    ".github/workflows/kpmo-canonical-generation-v3-apply.yml",
    ".github/workflows/kpmo-canonical-generation-v3.yml",
    "coordination/kidults/governance/approval-policy-file-manifest-v1.json",
    "coordination/kidults/governance/approval-policy-inventory-v1.json",
    "scripts/kidults/kpmo/canonical-generation-v3.mjs"
  ],
  "automatic_triggers": [
    "pull_request_target:opened|synchronize|reopened|ready_for_review",
    "schedule:kidults-autonomous-dispatcher-v1",
    "repository_dispatch:kidults.track.authorization.v1",
    "repository_dispatch:kidults.kpmo.authorization.v1",
    "repository_dispatch:kidults.independent.verification.v1"
  ],
  "manual_trigger": "RECOVERY_ONLY_NEW_AUTHORIZATION_GENERATION_REQUIRED",
  "bounded_recovery": {
    "maximum_attempts": 3,
    "maximum_lifetime_seconds": 7200,
    "same_head_tree_required": true,
    "same_scope_digest_required": true,
    "empty_commit_must_be_non_force": true,
    "head_sha_generations_must_be_receipted": true,
    "draft_ready_rebind": "AUTOMATIC",
    "draft_ready_validation_timeout_seconds": 420,
    "pre_reservation_failure_consumes_authority": false,
    "reservation_occurs_immediately_before_first_mutation": true
  },
  "durable_single_use": {
    "backend": "AWS_DYNAMODB_CONDITIONAL_WRITE",
    "table_variable": "KIDULTS_AUTONOMOUS_LANDING_LEDGER_TABLE",
    "workload_role_arn_variable": "KIDULTS_AUTONOMOUS_WORKLOAD_ROLE_ARN",
    "signing_key_arn_variable": "KIDULTS_AUTONOMOUS_SIGNING_KEY_ARN",
    "region": "ap-northeast-2",
    "transition": "UNUSED_TO_RESERVED_TO_CONSUMED",
    "reservation_and_consume_require_finalizer_kms_signature": true,
    "github_artifact_alone_is_sufficient": false,
    "rerun_reuses_authority": false,
    "maximum_ttl_seconds": 7200
  },
  "merge": {
    "method": "merge",
    "expected_head_sha_required": true,
    "force_push_forbidden": true,
    "admin_bypass_forbidden": true,
    "update_branch_forbidden": true,
    "live_main_tree_parent_revalidation_required": true,
    "explicit_completion_event": "kidults.internal_landing.completed.v1",
    "postmerge_exact_sha_checks_required": true,
    "postmerge_validation_timeout_seconds": 420
  },
  "evidence_resolution": {
    "approval_decisions_must_be_derived_from_live_github_state": true,
    "caller_supplied_pass_conclusions_are_authoritative": false,
    "test_evidence_object_required": true,
    "rollback_plan_object_required": true,
    "canonical_json_digest_recomputed": true
  },
  "failure_recovery": {
    "automatic_downstream_quarantine": true,
    "automatic_revert_pr_required_after_postmerge_failure": true,
    "force_reset_forbidden": true,
    "revert_conflict_state": "OWNER_HOLD",
    "agent_violation_state": "AGENT_QUARANTINED",
    "replacement_requires_fresh_bootstrap_and_generation": true
  },
  "evidence": {
    "terminal_receipt_required": true,
    "digest_chain_required": true,
    "aws_object_lock_copy_required": true,
    "aws_object_lock_mode": "COMPLIANCE",
    "retention_years": 10,
    "production": "HOLD",
    "public": "HOLD",
    "g5": "HOLD",
    "usb_copy_a": "PENDING_PHYSICAL_MEDIA"
  },
  "principles": {
    "autonomous_effect": "Eligible reversible internal landing runs from governed agent events without routine Owner orchestration.",
    "global_effect": "One repository-wide authority model applies to every Track and internal workflow.",
    "irreplaceable_value_effect": "Authorization, rollback and evidence knowledge remain platform-owned and replayable.",
    "transparency_effect": "Every transition binds exact Git objects, role-scoped GitHub OIDC subject identity, KMS signing key, evidence digests and immutable receipts."
  },
  "workload_identity": {
    "required": [
      "workload_id",
      "environment",
      "workflow_ref",
      "workflow_sha",
      "repository_id",
      "signing_key_arn"
    ],
    "separation_key": "WORKLOAD_ID_AND_KMS_SIGNING_KEY",
    "runtime_allowlist_source": "KIDULTS_AUTONOMOUS_WORKLOAD_REGISTRY_JSON",
    "role_signature_required": true,
    "signature_algorithm": "ECDSA_SHA_256",
    "oidc_trust_conditions_required": [
      "aud",
      "sub"
    ],
    "github_sender_id_is_authority": false,
    "caller_supplied_workload_identity_allowed": false,
    "unknown_workload": "QUARANTINE",
    "approval_roles": [
      "ACCOUNTABLE_TRACK_AGENT",
      "KPMO",
      "INDEPENDENT_VERIFIER"
    ],
    "finalizer": {
      "role": "FINALIZER",
      "environment": "KIDULTS-AUTONOMOUS-FINALIZER",
      "distinct_workload_id_required": true,
      "distinct_signing_key_required": true,
      "only_stage_allowed_github_write": true,
      "approval_stage_github_write_forbidden": true
    },
    "oidc_subject_customization": {
      "required": true,
      "repository_setting_path": "coordination/kidults/governance/github-oidc-subject-customization-v1.json",
      "include_claim_keys": [
        "repo",
        "context",
        "workflow_ref"
      ],
      "aws_custom_claim_condition_keys_forbidden": true,
      "role_workflow_ref_must_be_distinct": true,
      "finalizer_may_trust_only_role_workflow_refs": true
    }
  }
}
