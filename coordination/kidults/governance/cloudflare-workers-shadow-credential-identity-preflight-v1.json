{
  "id": "kidults-cloudflare-workers-shadow-credential-identity-preflight-v1",
  "version": "1.0.0",
  "status": "MANDATORY_BEFORE_ANY_FUTURE_WORKERS_SHADOW_DEPLOYMENT_APPROVAL",
  "owner": "KPMO",
  "root_incident_issue": 1755,
  "blocked_approval": "CF-WORKERS-SHADOW-20260901-03",
  "blocked_workflow": ".github/workflows/kidults-cloudflare-workers-shadow-deploy-v3.yml",
  "purpose": "PROVE_CLOUDFLARE_ACCOUNT_ID_AND_API_TOKEN_REFER_TO_THE_SAME_AUTHORIZED_ACCOUNT_BEFORE_ANY_WORKER_MUTATION",
  "authority": {
    "standing_execution_authority": false,
    "separate_explicit_program_owner_approval_required": true,
    "read_only_external_calls_only": true,
    "worker_mutation_allowed": false,
    "routes_or_domains_allowed": false,
    "pages_mutation_allowed": false,
    "spend_contract_credential_creation_or_scope_expansion_allowed": false
  },
  "github_secret_boundary": {
    "environment": "kidults-cloudflare-staging-deploy",
    "required_secret_names": [
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_API_TOKEN"
    ],
    "environment_level_value_is_authoritative_when_duplicate_names_exist": true,
    "secret_values_may_be_logged_or_persisted": false,
    "secret_values_may_be_returned_to_user": false,
    "repository_level_duplicate_cleanup_requires_separate_security_approval": true
  },
  "required_preflight_sequence": [
    {
      "order": 1,
      "id": "LOCAL_ACCOUNT_ID_SHAPE",
      "external_call": false,
      "requirement": "CLOUDFLARE_ACCOUNT_ID_MATCHES_EXACT_32_HEX_WITH_NO_WHITESPACE",
      "logging": "BOOLEAN_ONLY"
    },
    {
      "order": 2,
      "id": "TOKEN_VERIFY",
      "external_call": true,
      "method": "GET",
      "endpoint": "https://api.cloudflare.com/client/v4/user/tokens/verify",
      "requirement": "HTTP_2XX_AND_SUCCESS_TRUE_AND_TOKEN_STATUS_ACTIVE",
      "mutation": false,
      "logging": "SANITIZED_STATUS_ONLY"
    },
    {
      "order": 3,
      "id": "ACCOUNT_IDENTITY_READ",
      "external_call": true,
      "method": "GET",
      "endpoint_template": "https://api.cloudflare.com/client/v4/accounts/{CLOUDFLARE_ACCOUNT_ID}",
      "requirement": "HTTP_2XX_AND_SUCCESS_TRUE_AND_RETURNED_ACCOUNT_ID_EXACTLY_MATCHES_SECRET",
      "mutation": false,
      "logging": "BOOLEAN_AND_NONREVERSIBLE_RUN_NONCE_HMAC_ONLY"
    },
    {
      "order": 4,
      "id": "WORKERS_ACCOUNT_SCOPE_READ",
      "external_call": true,
      "method": "GET",
      "endpoint_template": "https://api.cloudflare.com/client/v4/accounts/{CLOUDFLARE_ACCOUNT_ID}/workers/services?per_page=1",
      "requirement": "HTTP_2XX_OR_DOCUMENTED_EMPTY_SUCCESS_RESPONSE_WITHOUT_CODE_7003",
      "mutation": false,
      "logging": "STATUS_CODE_ERROR_CODE_CLASS_AND_BOOLEAN_ONLY"
    }
  ],
  "maximum_external_read_requests": 3,
  "required_receipt": {
    "location": "RUNNER_TEMP_OUTSIDE_GITHUB_WORKSPACE",
    "always_finalize": true,
    "always_upload": true,
    "fields": [
      "repository",
      "workflow",
      "source_sha",
      "run_id",
      "run_attempt",
      "approval_id_digest",
      "nonce",
      "expires_at",
      "account_id_shape_valid",
      "token_active",
      "account_id_matches_token_access",
      "workers_account_scope_readable",
      "cloudflare_error_codes",
      "external_read_request_count",
      "worker_mutation_count",
      "secret_values_logged",
      "public",
      "production",
      "g5"
    ],
    "forbidden_fields": [
      "cloudflare_account_id",
      "cloudflare_api_token",
      "authorization_header",
      "raw_account_response",
      "raw_token_response"
    ]
  },
  "pass_condition": {
    "account_id_shape_valid": true,
    "token_active": true,
    "account_id_matches_token_access": true,
    "workers_account_scope_readable": true,
    "cloudflare_error_7003_observed": false,
    "worker_mutation_count": 0,
    "secret_values_logged": false
  },
  "failure_behavior": {
    "fail_closed": true,
    "provider_deployment_authority_created": false,
    "same_approval_reusable": false,
    "automatic_retry_allowed": false,
    "secret_value_disclosure_allowed": false
  },
  "future_deployment_gate": {
    "new_versioned_workflow_required": true,
    "new_explicit_program_owner_deployment_approval_required": true,
    "preflight_receipt_exact_main_sha_binding_required": true,
    "preflight_receipt_not_expired_required": true,
    "preflight_pass_must_precede_provider_attempt_marker": true,
    "maximum_provider_deployment_attempts": 1,
    "success_requires_workers_dev_https_2xx_nonempty_readback": true
  },
  "release_boundary": {
    "production_routes": 0,
    "custom_domains": 0,
    "pages_delete": "FORBIDDEN",
    "pages_domain_detach": "FORBIDDEN",
    "public": "HOLD",
    "production": "HOLD",
    "g5": "HOLD"
  }
}
