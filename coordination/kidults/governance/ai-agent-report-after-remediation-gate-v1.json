{
  "id": "kidults-ai-agent-report-after-remediation-gate-v1",
  "version": "1.2.0",
  "status": "MANDATORY_FAIL_CLOSED",
  "owner": "KPMO",
  "scope": "REPOSITORY_GOVERNED_AI_AGENT_STATUS_RECEIPTS",
  "behavioral_scope": "ALL_AI_AGENTS_STATUS_AND_PROGRESS_REPORTING",
  "machine_enforcement_scope": "REGISTERED_REPOSITORY_STATUS_RECEIPT_PATHS",
  "external_chat_output_interception_claimed": false,
  "purpose": "Prevent report-before-fix behavior for reversible internal defects within granted authority, then require material strategic implications to be surfaced after verified remediation without falsely claiming interception of external chat output.",
  "normal_report_gate": {
    "authorized_reversible_defect_present": "REMEDIATION_SEQUENCE_MUST_COMPLETE_BEFORE_ROUTINE_REPORT",
    "required_sequence": [
      "ROOT_CAUSE_CORRECTED",
      "REGRESSION_TESTED",
      "NEGATIVE_TESTED",
      "EXACT_HEAD_REVALIDATED",
      "TARGET_MAIN_REVALIDATED_OR_PREMERGE_NOT_APPLICABLE",
      "REGISTRY_ISSUE_TRUTH_SYNCED",
      "VERIFIED_OUTCOME_READY",
      "PRIORITIZED_IMPROVEMENT_PROPOSAL_READY"
    ],
    "report_only_allowed": false
  },
  "strategic_stewardship_after_remediation": {
    "required_when_material": true,
    "required_domains": ["PRODUCT_STRATEGY","CUSTOMER_STRATEGY","PLATFORM_STRATEGY","PROVIDER_STRATEGY","INTERNALIZATION_STRATEGY","GROUP_FUTURE_STRATEGY","VERTICAL_FUTURE_STRATEGY"],
    "strategy_must_not_delay_executable_internal_fix": true,
    "not_applicable_requires_reason": true
  },
  "protected_stop_exception": {
    "allowed_only_when": [
      "PRODUCTION_G5",
      "IRREVERSIBLE_LEGAL_CHANGE",
      "IRREVERSIBLE_SECURITY_CHANGE",
      "EXTERNAL_SPEND",
      "CONTRACTUAL_COMMITMENT",
      "EXPANDED_CREDENTIAL_OR_PERMISSION",
      "PROVIDER_ACTIVATION_REQUIRING_SEPARATE_AUTHORITY",
      "MISSING_REQUIRED_TOOL_OR_PERMISSION"
    ],
    "required_behavior": "FAIL_CLOSED_AND_REPORT_EXACT_BLOCKER_AND_UNBLOCK_CONDITION"
  },
  "report_receipt_minimum": {
    "required_fields": [
      "defect_disposition",
      "remediation_sequence",
      "verification_evidence_refs",
      "truth_sync_refs",
      "improvement_proposal"
    ],
    "defect_disposition_values": [
      "NO_REVERSIBLE_DEFECT_DETECTED",
      "REMEDIATED_AND_VERIFIED",
      "PROTECTED_STOP_BLOCKED"
    ]
  },
  "machine_receipt_rule": {
    "receipt_must_pass_canonical_status_schema": true,
    "receipt_must_pass_report_after_remediation_validator": true,
    "synthetic_self_test_alone_counts_as_end_to_end_report_enforcement": false,
    "registered_workflow_must_emit_and_validate_real_run_receipt": true
  },
  "violation": {
    "report_before_authorized_remediation": "P1_OPERATING_DEFECT",
    "material_strategy_implication_omitted_after_remediation": "P1_OPERATING_DEFECT",
    "false_remediation_or_verification_claim": "P0_GOVERNANCE_DEFECT",
    "machine_enforcement_scope_overclaim": "P0_GOVERNANCE_DEFECT",
    "self_exemption_allowed": false
  },
  "production": "HOLD",
  "public_release": "HOLD",
  "g5": "HOLD"
}
