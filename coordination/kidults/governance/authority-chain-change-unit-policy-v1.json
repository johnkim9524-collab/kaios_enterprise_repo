{
  "id": "kidults-authority-chain-change-unit-policy-v1",
  "version": "1.0.0",
  "status": "MANDATORY_FAIL_CLOSED_AFTER_MAIN_MERGE",
  "owner": "KPMO",
  "scope": "REPOSITORY_WIDE_MATERIAL_CHANGES",
  "rule_id": "AI-021",
  "rule_name": "WHOLE_AUTHORITY_CHAIN_CHANGE_UNIT",
  "change_unit": "WHOLE_AUTHORITY_CHAIN_NOT_SINGLE_FILE",
  "canonical_chain": [
    "PRODUCER",
    "ARTIFACT",
    "AUTONOMOUS_RESOLUTION_LAYER",
    "REQUIREMENT",
    "RESERVE",
    "CANONICAL_TRUTH",
    "PRODUCER_HEALTH_SENTINEL"
  ],
  "mandatory_impact_dimensions": [
    "PRODUCER_SCHEMA_AND_VERSION",
    "CONSUMER_SCHEMA_AND_VERSION",
    "ARTIFACT_IDENTITY_DIGEST_AND_RETENTION",
    "TRIGGER_ORDERING_CONCURRENCY_AND_RETRY",
    "AUTHORITY_PROVENANCE_AND_EXACT_SHA_BINDING",
    "FIXTURES_VALIDATORS_WORKFLOWS_AND_INVENTORIES",
    "FAILURE_PROPAGATION_RECOVERY_AND_ROLLBACK",
    "OBSERVABILITY_TERMINAL_RECEIPTS_AND_CANONICAL_TRUTH"
  ],
  "required_validation": {
    "producer_consumer_contract_matrix": true,
    "supported_version_positive_cases": true,
    "unsupported_stale_and_future_version_negative_cases": true,
    "regression_tests": true,
    "adversarial_tests": true,
    "exact_head_validation": true,
    "exact_landed_main_reproduction_and_consumption": true,
    "canonical_truth_after_upstream_terminal_completion": true,
    "producer_health_sentinel_success_before_complete": true
  },
  "completion_policy": {
    "single_file_validation_sufficient": false,
    "pr_checks_alone_sufficient": false,
    "downstream_unverified_allowed": false,
    "complete_claim_before_exact_main_sentinel_success_allowed": false,
    "unclassified_chain_failure": "VERIFIED_FAIL",
    "missing_chain_evidence": "HOLD"
  },
  "authority_boundary": {
    "production": "HOLD",
    "public": "HOLD",
    "g5": "HOLD",
    "owner_reserved_gates_preserved": true,
    "policy_does_not_grant_merge_release_deployment_or_external_action_authority": true
  }
}
