      "mobile_safari_required": true,
      "simulator_or_emulation_eligible": false,
      "human_reviewer_required": true,
      "minimum_hashed_evidence_refs": 2,
      "signed_human_attestation_required": true,
      "cryptographic_machine_verification_required": true,
      "self_asserted_signed_boolean_eligible": false
    },
    "screen_reader": {
      "evidence_class": "PHYSICAL_IPHONE_VOICEOVER_HUMAN_ACCEPTANCE",
      "technology": "VoiceOver",
      "required_checks": [
        "landmarks",
        "name_role_value",
        "focus_order",
        "focus_restoration",
        "menu_announcement",
        "status_announcement",
        "error_announcement"
      ],
      "same_physical_device_session_required": true,
      "human_operated_required": true,
      "minimum_hashed_evidence_refs": 2,
      "signed_human_attestation_required": true,
      "cryptographic_machine_verification_required": true,
      "self_asserted_signed_boolean_eligible": false
    }
