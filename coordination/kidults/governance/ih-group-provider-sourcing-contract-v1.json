  "negotiation_communication_policy": {
    "status": "MANDATORY_NON_BYPASS",
    "channel": "WRITTEN_EMAIL_ONLY",
    "program_owner_native_language": "NOT_ENGLISH",
    "phone_voice_video_calls": "NOT_AVAILABLE",
    "reason": "Accuracy of technical, rights, pricing, commercial and contractual terms and an auditable record are mandatory because English is not the Program Owner's native language.",
    "provider_call_request": "POLITELY_DECLINE_AND_REQUEST_WRITTEN_EMAIL_RESPONSE",
    "provider_call_requirement": "HOLD_OR_REPLACE",
    "verbal_only_material_terms": "NON_ADMISSIBLE",
    "agent_must_not": [
      "offer-or-accept-a-call",
      "ask-the-program-owner-for-call-availability",
      "describe-a-call-as-the-next-step",
      "suggest-a-call-after-email-alignment",
      "treat-verbal-statements-as-rights-commercial-or-contract-evidence"
    ],
    "material_terms_must_be_written": [
      "rights-and-permitted-uses",
      "schema-and-field-semantics",
      "pricing-volume-and-minimums",
      "term-renewal-cancellation-and-notice",
      "retention-deletion-and-post-termination",
      "derived-output-and-pre-existing-ip",
      "attribution-display-and-redistribution",
      "quota-sla-support-and-schema-change",
      "security-privacy-and-audit",
      "assignment-novation-and-change-of-control"
    ]
  },
  "provider_outbound_pre_send_policy": {
    "status": "MANDATORY_NON_BYPASS",
    "scope": "EVERY_EXTERNAL_PROVIDER_EMAIL_DRAFT_FORWARD_REPLY_AND_SEND",
    "required_order": [
      "REFRESH_CURRENT_PROVIDER_AND_THREAD_EVIDENCE",
      "PREPARE_DETAILED_RESPONSE_STRATEGY",
      "KPMO_REVIEW_STRATEGY_AND_EXACT_EMAIL_PACKAGE",
      "REPORT_STRATEGY_KPMO_VERDICT_RISKS_AND_EXACT_PACKAGE_TO_PROGRAM_OWNER_IN_KOREAN",
      "RECORD_PROGRAM_OWNER_EXACT_CONTENT_SEND_APPROVAL",
      "SEND_ONLY_APPROVED_PACKAGE",
      "CAPTURE_GMAIL_SEND_EVIDENCE_AND_TRUTH_SYNC_REGISTRY"
    ],
    "kpmo_review_verdicts": [
      "APPROVED_FOR_PROGRAM_OWNER_REVIEW",
      "REVISE",
      "DO_NOT_SEND",
      "WAIT"
    ],
    "self_authored_candidate_requires_distinct_second_pass_adversarial_review": true,
    "kpmo_review_is_send_authority": false,
    "program_owner_approval_must_bind": [
      "sender_identity",
      "to_recipients",
      "cc_recipients",
      "bcc_recipients",
      "thread_or_reply_target",
      "subject",
      "complete_body",
      "attachments",
      "links",
      "deterministic_content_digest"
    ],
    "content_digest_specification": {
      "algorithm": "SHA-256",
      "encoding": "sha256:lowercase-hex",
      "canonicalization": "RFC_8785_JSON",
      "text_encoding": "UTF-8",
      "line_endings": "CRLF_NORMALIZED_TO_LF",
      "array_order": "PRESERVED",
      "attachments_bind": [
        "filename",
        "media_type",
        "byte_length",
        "sha256"
      ]
    },
    "post_approval_change_invalidates_approval": true,
    "gmail_draft_creation_before_both_gates": "PROHIBITED",
    "send_before_both_gates": "DO_NOT_DRAFT_OR_SEND",
    "approval_scope": "EXACT_OUTBOUND_COMMUNICATION_ONLY_NO_OTHER_AUTHORITY"
  },
  "vertical_posture": {
    "Intelligence Holdings": "open-authority-first; buy shared utility only after measured multi-product reuse",
