{
  "id": "kidults-human-autonomy-authority-controls-v1",
  "version": "1.0.0",
  "status": "ACTIVE",
  "canonical_main_binding": "PROTECTED_MAIN_HEAD_AT_READ",
  "operating_principles": ["AUTONOMOUS", "GLOBAL", "IRREPLACEABLE_VALUE", "TRANSPARENT"],
  "controls": [
    {
      "id": "AUTOMATION_BIAS",
      "severity": "P0_P1",
      "rules": [
        "HUMAN_ACCEPTANCE_MUST_NOT_BE_ASSUMED_FROM_MACHINE_CONFIDENCE",
        "HIGH_IMPACT_DECISIONS_MUST_SURFACE_COUNTEREVIDENCE_UNCERTAINTY_AND_ABSTENTION_OPTIONS",
        "OPERATOR_ACKNOWLEDGEMENT_MUST_NOT_BE_TREATED_AS_INDEPENDENT_VALIDATION"
      ]
    },
    {
      "id": "AUTHORITY_AMBIGUITY",
      "severity": "P0",
      "required_fields": ["DECISION_CLASS", "MACHINE_AUTHORITY", "HUMAN_AUTHORITY", "ESCALATION_OWNER", "PRODUCTION_GATE"],
      "rules": [
        "EVERY_MATERIAL_ACTION_MUST_HAVE_ONE_EXPLICIT_AUTHORITY_STATE",
        "NO_IMPLICIT_AUTHORITY_TRANSFER_FROM_RECOMMENDATION_TO_EXECUTION",
        "G5_AND_PRODUCTION_AUTHORITY_REMAIN_EXPLICITLY_HUMAN"
      ]
    },
    {
      "id": "SILENT_ESCALATION_FAILURE",
      "severity": "P0",
      "rules": [
        "ESCALATION_REQUIRING_EVENTS_MUST_EMIT_ACKNOWLEDGEABLE_RECEIPTS",
        "UNACKNOWLEDGED_P0_ESCALATION_FAILS_CLOSED_AFTER_DEFINED_TTL",
        "ESCALATION_DELIVERY_SUCCESS_NE_ESCALATION_ACKNOWLEDGEMENT"
      ]
    },
    {
      "id": "HUMAN_RUBBER_STAMPING",
      "severity": "P0_P1",
      "rules": [
        "MATERIAL_HUMAN_APPROVAL_REQUIRES_REASON_OR_ACCEPTED_EVIDENCE_REFERENCE",
        "REPEATED_IDENTICAL_APPROVAL_PATTERNS_TRIGGER_REVIEW_OF_EFFECTIVE_INDEPENDENCE",
        "APPROVAL_COUNT_NE_REVIEW_QUALITY"
      ]
    },
    {
      "id": "OVERRIDE_DRIFT",
      "severity": "P0",
      "rules": [
        "TEMPORARY_OVERRIDE_MUST_EXPIRE_AUTOMATICALLY",
        "REPEATED_OVERRIDE_OF_SAME_GATE_CREATES_OVERRIDE_DEBT_AND_REQUIRES_ROOT_CAUSE_REVIEW",
        "OVERRIDE_FREQUENCY_CANNOT_NORMALIZE_EXCEPTION_INTO_POLICY"
      ]
    },
    {
      "id": "RESPONSIBILITY_DIFFUSION",
      "severity": "P0_P1",
      "rules": [
        "EVERY_MATERIAL_DECISION_MUST_BIND_ONE_ACCOUNTABLE_OWNER",
        "MULTI_AGENT_OR_MULTI_TEAM_PARTICIPATION_DOES_NOT_REMOVE_ACCOUNTABILITY",
        "NO_DECISION_MAY_END_IN_OWNER_UNKNOWN"
      ]
    },
    {
      "id": "OPERATOR_COGNITIVE_OVERLOAD",
      "severity": "P1_P0_AT_SCALE",
      "rules": [
        "P0_AND_P1_ALERTS_MUST_BE_PRIORITY_BOUNDED_AND_DEDUPLICATED",
        "LOW_VALUE_ALERT_VOLUME_MUST_NOT_SUPPRESS_MATERIAL_ESCALATIONS",
        "EXECUTIVE_SURFACES_MUST_PRESERVE_TRUTH_WHILE_REDUCING_NON_DECISION_RELEVANT_DETAIL"
      ]
    }
  ],
  "activation_ceiling": {
    "empirical_promotion": "PROHIBITED_FROM_CONTROL_OR_SYNTHETIC_TESTS",
    "live_mutation": "DISABLED_UNTIL_SEPARATE_ACTIVATION_GATE",
    "production": "HOLD",
    "g5": "EXPLICIT_APPROVAL_REQUIRED"
  }
}
