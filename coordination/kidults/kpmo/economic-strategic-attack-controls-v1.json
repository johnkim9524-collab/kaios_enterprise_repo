{
  "id": "kidults-economic-strategic-attack-controls-v1",
  "version": "1.0.0",
  "status": "ACTIVE",
  "canonical_main_binding": "PROTECTED_MAIN_HEAD_AT_READ",
  "operating_principles": ["AUTONOMOUS", "GLOBAL", "IRREPLACEABLE_VALUE", "TRANSPARENT"],
  "objective": "Protect KIDULTS intelligence and strategic optionality when competitors, providers, market participants, regulators or customers create economically rational pressure that can distort evidence, access, market interpretation or decision quality.",
  "controls": [
    {
      "id": "COMPETITOR_INTELLIGENCE_POISONING",
      "severity": "P0_P1",
      "rules": [
        "PUBLIC_OR_DISCOVERABLE_KIDULTS_METHODS_MUST_NOT_CREATE_A_SINGLE_STABLE_INPUT_PATTERN_THAT_CAN_STEER_MATERIAL_INTELLIGENCE",
        "SUSPECT_STRATEGIC_INPUT_CLUSTERS_REQUIRE_ORIGIN_DIVERSITY_TEMPORAL_STABILITY_AND_REMOVAL_SENSITIVITY_BEFORE_MATERIAL_WEIGHT",
        "COMPETITOR_IDENTITY_OR_INTENT_REMAINS_UNKNOWN_UNLESS_EVIDENCED",
        "ANOMALOUS_EVIDENCE_THAT_IS_LAWFUL_AND_SCHEMA_VALID_MAY_STILL_BE_QUARANTINED_FROM_REPRESENTATIVENESS_SENSITIVE_CLAIMS"
      ]
    },
    {
      "id": "COORDINATED_LIQUIDITY_ILLUSION",
      "severity": "P0",
      "rules": [
        "LISTING_COUNT_BID_ACTIVITY_OR_SHORT_WINDOW_TURNOVER_MUST_NOT_ALONE_ESTABLISH_LIQUIDITY",
        "LIQUIDITY_REQUIRES_REALIZED_TRANSACTION_DEPTH_TIME_TO_SALE_FAILED_SALE_OR_WITHDRAWAL_CONTEXT_AND_SOURCE_ORIGIN_DIVERSITY_AS_AVAILABLE",
        "BURST_LIQUIDITY_SIGNALS_REQUIRE_PERSISTENCE_AND_POST_WINDOW_REVERSION_CHECKS",
        "LIQUIDITY_CONFIDENCE_MUST_DECREASE_WHEN_ACTIVITY_CONCENTRATION_OR_COUNTERPARTY_CORRELATION_RISES"
      ]
    },
    {
      "id": "SOURCE_EXCLUSIVITY_WARFARE",
      "severity": "P0_P1",
      "rules": [
        "EXCLUSIVE_SOURCE_ACCESS_MUST_BE_RECORDED_AS_STRATEGIC_CONCENTRATION_DEBT_NOT_AUTOMATIC_COMPETITIVE_ADVANTAGE",
        "CRITICAL_CLAIMS_REQUIRE_REPLACEMENT_PATH_OR_EXPLICIT_SINGLE_AUTHORITY_CLAIM_CEILING",
        "TERMS_PRICE_OR_ACCESS_SHOCK_MUST_TRIGGER_DEGRADED_MODE_OR_HOLD_RATHER_THAN_SEMANTIC_WEAKENING",
        "SOURCE_ROI_MUST_INCLUDE_REPLACEMENT_LEAD_TIME_SWITCHING_COST_RIGHTS_FRICTION_AND_COVERAGE_LOSS"
      ]
    },
    {
      "id": "REGULATORY_FRAGMENTATION",
      "severity": "P0_P1",
      "rules": [
        "GLOBAL_PRODUCT_BEHAVIOR_MUST_NOT_ASSUME_ONE_JURISDICTIONS_RIGHTS_PRIVACY_CONSUMER_OR_DATA_RULES_APPLY_GLOBALLY",
        "EACH_MATERIAL_CLAIM_OR_DATA_PATH_MUST_BE_CAPABLE_OF_JURISDICTION_SCOPED_RIGHTS_AND_POLICY_STATE",
        "REGULATORY_UNCERTAINTY_MUST_NARROW_CLAIM_SCOPE_OR_HOLD_AFFECTED_SURFACE_NOT_PROPAGATE_GLOBAL_DEFAULTS",
        "GLOBAL_COMPARABILITY_MAY_NORMALIZE_DATA_BUT_MUST_PRESERVE_JURISDICTION_SPECIFIC_LIMITATIONS"
      ]
    },
    {
      "id": "JURISDICTION_ARBITRAGE",
      "severity": "P0_P1",
      "rules": [
        "A_MORE_PERMISSIVE_SOURCE_JURISDICTION_CANNOT_BE_USED_TO_BYPASS_THE_RIGHTS_OR_POLICY_REQUIREMENTS_OF_THE_ACTUAL_USE_CONTEXT",
        "DATA_ROUTING_LOCATION_DOES_NOT_CHANGE_FACTUAL_OR_LEGAL_ORIGIN_OR_INTENDED_USE",
        "CROSS_BORDER_TRANSFORMATIONS_MUST_PRESERVE_RIGHTS_LINEAGE_RETENTION_AND_POLICY_CONSTRAINTS",
        "WHEN_JURISDICTION_IS_UNKNOWN_THE_MORE_PERMISSIVE_INTERPRETATION_MUST_NOT_BE_ASSUMED"
      ]
    },
    {
      "id": "REPUTATION_ATTACK_AND_NARRATIVE_CAPTURE",
      "severity": "P1_P0_IF_PUBLIC",
      "rules": [
        "PUBLIC_CLAIMS_MUST_BE_REPRODUCIBLE_FROM_VERSIONED_EVIDENCE_METHOD_AND_LIMITATIONS_WITHOUT_DEPENDING_ON_MARKETING_LANGUAGE",
        "DISPUTED_CLAIMS_REQUIRE_EVIDENCE_PRESERVATION_RESPONSE_TRACE_AND_CORRECTION_OR_HOLD_PATH",
        "EXTERNAL_CRITICISM_OR_POPULARITY_MUST_NOT_DIRECTLY_CHANGE_FACTUAL_CONFIDENCE_WITHOUT_NEW_EVIDENCE",
        "CORRECTION_HISTORY_MUST_BE_TRANSPARENT_WITHOUT_ERASING_PRIOR_STATE"
      ]
    },
    {
      "id": "CUSTOMER_SIDE_GAMING",
      "severity": "P0_P1",
      "rules": [
        "USER_SUBMITTED_INTEREST_WATCHLIST_SEARCH_OR_PORTFOLIO_ACTIVITY_MUST_NOT_BE_TREATED_AS_INDEPENDENT_MARKET_DEMAND_WITHOUT_ANTI_GAMING_CONTROLS",
        "ONE_ACTOR_OR_LINKED_ACTOR_CLUSTER_MUST_NOT_CREATE_PROPORTIONAL_MULTIPLE_SIGNAL_WEIGHT",
        "CUSTOMER_BEHAVIOR_USED_FOR_INTELLIGENCE_REQUIRES_RATE_BOUNDING_SYBIL_RESISTANCE_OR_EXPLICIT_LOW_TRUST_CLASSIFICATION_AS_APPROPRIATE",
        "CUSTOMER_FEEDBACK_MAY_IMPROVE_PRODUCT_UTILITY_BUT_CANNOT_OVERRIDE_EXTERNAL_MARKET_EVIDENCE_REQUIREMENTS"
      ]
    }
  ],
  "strategic_truth_ceiling": {
    "counterparty_intent": "UNKNOWN_UNLESS_EVIDENCED",
    "synthetic_or_control_evidence": "NON_PROMOTABLE_TO_EMPIRICAL_PASS",
    "public": "HOLD",
    "production": "HOLD",
    "live_mutation": "DISABLED_UNTIL_SEPARATE_ACTIVATION_GATE",
    "g5": "EXPLICIT_APPROVAL_REQUIRED"
  }
}
