{
  "id": "kidults-institutional-continuity-sovereignty-controls-v1",
  "version": "1.0.0",
  "status": "ACTIVE",
  "canonical_main_binding": "PROTECTED_MAIN_HEAD_AT_READ",
  "operating_principles": ["AUTONOMOUS", "GLOBAL", "IRREPLACEABLE_VALUE", "TRANSPARENT"],
  "objective": "Ensure KIDULTS retains institutional control, memory, recoverability and lawful operating continuity despite loss of a person, key, account, region, legal entity, registry or archival service.",
  "controls": [
    {
      "id": "KEY_PERSON_DEPENDENCY",
      "severity": "P0_P1",
      "rules": [
        "NO_CRITICAL_OPERATION_OR_TRUTH_RECONSTRUCTION_MAY_DEPEND_ON_ONE_PERSON_ONLY",
        "CRITICAL_RUNBOOKS_AND_DECISION_CONTEXT_MUST_BE_VERSIONED_AND_INSTITUTIONALLY_ACCESSIBLE",
        "SUCCESSION_TESTS_MUST_PROVE_A_SECOND_AUTHORIZED_ROLE_CAN_RECONSTRUCT_STATE_WITHOUT_PRIVATE_MEMORY",
