      ]
    },
    {
      "id": "CRYPTOGRAPHIC_KEY_AND_CREDENTIAL_CONTINUITY",
      "severity": "P0",
      "rules": [
        "KEY_LOSS_AND_KEY_COMPROMISE_REQUIRE_DISTINCT_RECOVERY_PATHS",
        "NO_SINGLE_UNRECOVERABLE_KEY_MAY BE_THE_ONLY_PATH_TO_CRITICAL_TRUTH_OR_CONTROL",
        "ROTATION_RECOVERY_AND_REVOCATION_MUST_PRESERVE_AUDIT_BINDING_WITHOUT_EXPOSING_SECRET_MATERIAL",
        "RECOVERY_MATERIAL_MUST_BE_SCOPE_BOUNDED_AND_SEPARATED_FROM_ROUTINE_RUNTIME_USE"
      ]
    },
    {
      "id": "REGISTRY_SOVEREIGNTY",
      "severity": "P0",
      "rules": [
        "REGISTRY_IS_SYSTEM_OF_RECORD_NOT_SINGLE_VENDOR_API",
        "CRITICAL_REGISTRY_STATE_MUST_HAVE_PORTABLE_VERSIONED_EXPORT_WITH_DIGEST_AND_LINEAGE",
        "LOSS_OF_REGISTRY_SERVICE_MUST_NOT_ERASE_SNAPSHOT_ASSESSMENT_RIGHTS_OR_DECISION_HISTORY",
        "RESTORED_REGISTRY_MUST_PROVE_EPOCH_AND_DIGEST_COMPATIBILITY_BEFORE_REOPEN"
      ]
    },
    {
      "id": "CLOUD_AND_REGION_SOVEREIGNTY",
      "severity": "P0_P1",
      "rules": [
