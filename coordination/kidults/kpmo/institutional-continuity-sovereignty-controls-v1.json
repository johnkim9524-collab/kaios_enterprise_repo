        "CRITICAL_BACKUP_AND_RECONSTRUCTION_PATH_MUST_NOT_REQUIRE_THE_FAILED_PRIMARY_REGION",
        "CLOUD_SERVICE_LOSS_MUST_DEGRADE_TO_EXPLICIT_HOLD_OR_READ_ONLY_MODE_NOT_SILENT_TRUTH_LOSS",
        "REGION_AND_SERVICE_DEPENDENCIES_MUST_BE_REPORTED_AS_FAILURE_DOMAINS"
      ]
    },
    {
      "id": "LEGAL_ENTITY_AND_ACCOUNT_OWNERSHIP_CONTINUITY",
      "severity": "P1_P0_BEFORE_SCALE",
      "rules": [
        "CRITICAL_DOMAINS_REPOSITORIES_CLOUD_ACCOUNTS_AND_PROVIDER_RELATIONSHIPS_MUST_HAVE_EXPLICIT_INSTITUTIONAL_OWNER_STATE",
        "PERSONAL_ACCOUNT_CONTROL_MUST_NOT_BE_THE_ONLY_CONTINUITY_PATH_FOR_INSTITUTIONAL_ASSETS",
        "ENTITY_CHANGE_MERGER_OR_RESTRUCTURING_MUST_TRIGGER_RIGHTS_AND_CONTROL_REVALIDATION",
        "OWNERSHIP_TRANSFER_MUST_PRESERVE_AUDIT_AND_APPROVAL_HISTORY"
      ]
    },
    {
      "id": "ARCHIVAL_INDEPENDENCE",
      "severity": "P0_P1",
      "rules": [
        "BACKUP_NE_ARCHIVE_AND_ARCHIVE_NE_LIVE_REPLICA",
        "CRITICAL_TRUTH_HISTORY_MUST_HAVE_TAMPER_EVIDENT_OFFLINE_OR_INDEPENDENT_RECOVERY_REPRESENTATION",
        "ARCHIVE_RESTORE_MUST_BE_PERIODICALLY_REPLAYED_AND_VERIFIED_NOT_MERELY_STORED",
        "RETENTION_AND_RIGHTS_DELETION_MUST_PROPAGATE_TO_ARCHIVES_WITH_AUDIT_TOMBSTONES_WHERE_REQUIRED"
      ]
    },
    {
      "id": "INSTITUTIONAL_MEMORY_LOSS",
      "severity": "P0_P1",
      "rules": [
        "DECISION_RATIONALE_METHOD_VERSION_LIMITATIONS_AND_REJECTED_ALTERNATIVES_MUST_SURVIVE_PERSONNEL_CHANGE",
        "CHAT_OR_VERBAL_CONTEXT_ALONE_IS_NOT_CANONICAL_INSTITUTIONAL_MEMORY",
        "MATERIAL_DECISIONS_REQUIRE_REPRODUCIBLE_RECEIPTS_BOUND_TO_REGISTRY_AND_EVIDENCE_STATE",
        "RECOVERY_TEST_MUST_PROVE_WHY_AS_WELL_AS_WHAT_CAN_BE_RECONSTRUCTED"
