{
  "id": "kidults-ontology-entity-integrity-controls-v1",
  "version": "1.0.0",
  "status": "ACTIVE",
  "operating_principles": ["AUTONOMOUS", "GLOBAL", "IRREPLACEABLE_VALUE", "TRANSPARENT"],
  "objective": "Prevent entity-resolution, ontology and identifier errors from contaminating downstream intelligence, while preserving reversible lineage and fail-closed ambiguity handling.",
  "truth_rules": [
    "IDENTIFIER_MATCH_NE_ENTITY_IDENTITY",
    "ALIAS_MATCH_NE_CANONICAL_MERGE",
    "SAME_NAME_NE_SAME_OBJECT",
    "SAME_OBJECT_NE_SAME_VARIANT",
    "AMBIGUITY_NE_ZERO",
    "ENTITY_MUTATION_REQUIRES_DEPENDENCY_REPLAY"
  ],
  "controls": [
    {
      "id": "FALSE_MERGE_PREVENTION",
      "severity": "P0",
      "rules": [
        "CANONICAL_MERGE_REQUIRES_MULTIPLE_COMPATIBLE_IDENTIFIERS_OR_AUTHORITATIVE_BINDING",
        "CONFLICTING_HIGH_AUTHORITY_IDENTIFIERS_FORCE_IDENTITY_QUARANTINE",
        "NAME_OR_DESCRIPTION_SIMILARITY_ALONE_CANNOT_MERGE"
      ]
    },
    {
      "id": "FALSE_SPLIT_PREVENTION",
      "severity": "P0",
      "rules": [
        "MULTIPLE_RECORDS_FOR_ONE_OBJECT_REQUIRE_ALIAS_LINKAGE_WHEN_IDENTITY_EVIDENCE_SUPPORTS_IT",
        "REGIONAL_OR_PROVIDER_NAMING_VARIATION_ALONE_CANNOT_CREATE_NEW_CANONICAL_ENTITY",
        "POTENTIAL_DUPLICATES_REMAIN_LINKED_AS_UNRESOLVED_UNTIL_ADJUDICATED"
      ]
    },
    {
      "id": "ALIAS_AND_IDENTIFIER_COLLISION",
      "severity": "P0",
      "rules": [
        "IDENTIFIER_NAMESPACE_AND_ISSUER_MUST_BE_EXPLICIT",
        "REUSED_OR_NON_UNIQUE_IDENTIFIERS_CANNOT_BE_TREATED_AS_GLOBAL_KEYS",
        "ALIAS_COLLISION_REQUIRES_CONFLICT_STATE_AND_NO_AUTO_PROMOTION"
      ]
    },
    {
      "id": "VARIANT_AND_EDITION_BOUNDARY",
      "severity": "P0",
      "rules": [
        "MODEL_SERIES_EDITION_GRADE_CONDITION_REGION_AND_YEAR_ARE_SEPARATE_IDENTITY_DIMENSIONS_WHEN_MATERIAL",
        "PARENT_ENTITY_AGGREGATION_CANNOT_ERASE_MATERIAL_VARIANT_DIFFERENCES",
        "COMPARABLES_MUST_DECLARE_ENTITY_GRAIN"
      ]
    },
    {
      "id": "ONTOLOGY_AND_TYPE_DRIFT",
      "severity": "P0",
      "rules": [
        "ONTOLOGY_CLASS_AND_RELATION_SEMANTICS_ARE_VERSIONED",
        "TYPE_RECLASSIFICATION_REQUIRES_IMPACT_ASSESSMENT_AND_REPLAY",
        "SCHEMA_COMPATIBILITY_DOES_NOT_IMPLY_ONTOLOGY_COMPATIBILITY"
      ]
    },
    {
      "id": "HIGH_FANOUT_IDENTITY_MUTATION",
      "severity": "P0",
      "rules": [
        "MERGE_SPLIT_REKEY_OR_RECLASSIFY_MUST_COMPUTE_DOWNSTREAM_DEPENDENCY_FANOUT",
        "HIGH_FANOUT_MUTATION_IS_SHADOW_FIRST_WITH_BEFORE_AFTER_DIGEST",
        "AFFECTED_CLAIMS_FACTORS_SNAPSHOTS_AND_PROJECTIONS_MUST_REPLAY_OR_HOLD"
      ]
    },
    {
      "id": "REVERSIBLE_ENTITY_LINEAGE",
      "severity": "P0",
      "rules": [
        "ENTITY_MERGE_SPLIT_AND_ALIAS_DECISIONS_MUST_PRESERVE_PREVIOUS_CANONICAL_IDS",
        "NO_DESTRUCTIVE_IDENTITY_REWRITE_WITHOUT_TOMBSTONE_AND_MAPPING_LINEAGE",
        "ROLLBACK_MUST_RESTORE_ENTITY_GRAPH_AND_DEPENDENT_CLAIM_STATE_TO_ONE_COMPATIBLE_EPOCH"
      ]
    }
  ],
  "activation_ceiling": {
    "synthetic_or_control_tests": "NON_PROMOTABLE",
    "empirical_promotion": "PROHIBITED_FROM_CONTROL_OR_SYNTHETIC_TESTS",
    "live_mutation": "DISABLED_UNTIL_SEPARATE_ACTIVATION_GATE",
    "production": "HOLD",
    "g5": "EXPLICIT_APPROVAL_REQUIRED"
  }
}
