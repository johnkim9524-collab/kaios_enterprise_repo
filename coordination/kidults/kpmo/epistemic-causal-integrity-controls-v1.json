  "epistemic_truth_ceiling": {
    "causal_claim_without_identification": "PROHIBITED",
    "synthetic_or_control_evidence": "NON_PROMOTABLE_TO_EMPIRICAL_PASS",
    "cross_market_causality": "DEFERRED_UNTIL_EMPIRICAL_PREREQUISITES_AND_OUT_OF_SAMPLE_CONTROLS",
