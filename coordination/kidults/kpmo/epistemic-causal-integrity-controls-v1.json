        "UNIDENTIFIED_MECHANISM_MUST_BE_LABELLED_ASSOCIATIONAL_OR_PREDICTIVE"
      ]
    },
    {
      "id": "CONFOUNDER_AND_MEDIATOR_CONTROL",
      "severity": "P0_P1",
      "required_checks": ["KNOWN_CONFOUNDERS", "PROXY_CONFOUNDERS", "MEDIATORS", "COLLIDERS", "REGIME_STATE", "CATEGORY_GEOGRAPHY_TIME"],
      "rules": [
        "MATERIAL_CAUSAL_CLAIMS_MUST_ENUMERATE_KNOWN_CONFOUNDERS_AND_UNRESOLVED_CONFOUNDER_DEBT",
        "CONTROLLING_FOR_A_MEDIATOR_OR_COLLIDER_REQUIRES_EXPLICIT_RATIONALE",
        "UNKNOWN_CONFOUNDING_CANNOT_BE_SERIALIZED_AS_ZERO"
      ]
    },
    {
      "id": "SELECTION_AND_SURVIVORSHIP_BIAS",
      "severity": "P0_P1",
      "rules": [
        "OBSERVED_SAMPLE_NE_TARGET_POPULATION",
        "SOLD_ONLY_OR_VISIBLE_ONLY_DATA_CANNOT_IMPLY_FULL_MARKET_BEHAVIOR_WITHOUT_SELECTION_MODEL",
        "FAILED_WITHDRAWN_DELISTED_OR_UNOBSERVED_OUTCOMES_MUST_BE_INCLUDED_OR_EXPLICITLY_MISSING",
        "SURVIVORSHIP_FILTERING_MUST_REDUCE_CONFIDENCE_OR_TRIGGER_HOLD"
      ]
    },
    {
      "id": "POST_HOC_NARRATIVE_AND_HYPOTHESIS_DRIFT",
      "severity": "P1",
      "rules": [
        "POST_HOC_EXPLANATION_NE_PRE_REGISTERED_HYPOTHESIS",
        "HYPOTHESIS_OR_METRIC_CHANGED_AFTER_OUTCOME_MUST_BE_VERSIONED_AND_DISCLOSED",
        "EXPLANATION_SELECTION_AFTER_SEEING_RESULTS_CANNOT_AUTO_PROMOTE_CONFIDENCE",
        "CHALLENGER_HYPOTHESES_AND_REJECTED_EXPLANATIONS_MUST_REMAIN_AUDITABLE"
      ]
    },
    {
      "id": "MULTIPLE_TESTING_AND_FALSE_DISCOVERY",
      "severity": "P1_P0_BEFORE_CROSS_MARKET_ACTIVATION",
      "rules": [
        "SEARCHING_MANY_SIGNALS_REQUIRES_FALSE_DISCOVERY_CONTROL_OR_EQUIVALENT_GUARD",
        "BEST_OF_MANY_BACKTESTS_NE_OUT_OF_SAMPLE_VALIDATION",
        "SIGNIFICANCE_OR_SCORE_THRESHOLD_MUST_NOT_HIDE_TEST_COUNT",
        "CROSS_MARKET_RELATIONSHIP_REQUIRES_OUT_OF_SAMPLE_PERSISTENCE_AND_REGIME_SENSITIVITY"
      ]
    },
    {
      "id": "CAUSAL_TRANSPORTABILITY_AND_GLOBAL_GENERALIZATION",
      "severity": "P0_P1",
      "rules": [
        "LOCAL_EFFECT_NE_GLOBAL_EFFECT",
        "CATEGORY_OR_REGION_EFFECT_CANNOT_TRANSFER_WITHOUT_TRANSPORTABILITY_ASSUMPTIONS_AND_EVIDENCE",
        "GLOBAL_CLAIM_MUST_REPORT_HETEROGENEITY_AND_UNREPRESENTED_SURFACES",
        "PROXY_PARITY_CANNOT_FILL_MISSING_CATEGORY_GEOGRAPHY_CAUSAL_EVIDENCE"
      ]
    },
    {
      "id": "COUNTERFACTUAL_AND_INTERVENTION_SAFETY",
      "severity": "P0_BEFORE_HIGH_IMPACT_AUTONOMY",
      "rules": [
        "OBSERVATIONAL_MODEL_NE_INTERVENTION_MODEL",
        "WHAT_IF_OR_RECOMMENDATION_OUTPUT_MUST_DECLARE_COUNTERFACTUAL_ASSUMPTIONS_AND_UNCERTAINTY",
        "INTERVENTION_RECOMMENDATION_WITHOUT_IDENTIFIED_OR_ROBUST_EFFECT_IS_SHADOW_ONLY_OR_HOLD",
        "BUSINESS_VALUE_CANNOT_OVERRIDE_CAUSAL_IDENTIFICATION_DEBT"
      ]
