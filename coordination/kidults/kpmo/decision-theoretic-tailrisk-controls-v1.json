{
  "id": "kidults-decision-theoretic-tailrisk-controls-v1",
  "version": "1.0.0",
  "status": "ACTIVE",
  "canonical_main_binding": "PROTECTED_MAIN_HEAD_AT_READ",
  "operating_principles": ["AUTONOMOUS", "GLOBAL", "IRREPLACEABLE_VALUE", "TRANSPARENT"],
  "controls": [
    {
      "id": "PROBABILITY_VS_DECISION_UTILITY",
      "severity": "P0",
      "rules": [
        "CALIBRATED_PROBABILITY_NE_OPTIMAL_ACTION",
        "DECISION_REQUIRES_EXPLICIT_UTILITY_OR_LOSS_MODEL",
        "PREDICTION_CONFIDENCE_CANNOT_SUBSTITUTE_FOR_DECISION_VALUE"
      ]
    },
    {
      "id": "ASYMMETRIC_ERROR_COST",
      "severity": "P0",
      "required_costs": ["FALSE_POSITIVE", "FALSE_NEGATIVE", "DELAY", "REVERSAL", "OPPORTUNITY_COST"],
      "rules": [
        "DECISION_THRESHOLD_MUST_REFLECT_ASYMMETRIC_ERROR_COST",
        "ONE_THRESHOLD_CANNOT_BE_REUSED_ACROSS_MATERIALLY_DIFFERENT_DECISION_CONTEXTS"
      ]
    },
    {
      "id": "TAIL_RISK_AND_FAT_TAIL_SENSITIVITY",
      "severity": "P0",
      "rules": [
        "EXPECTED_VALUE_PASS_DOES_NOT_PROVE_TAIL_RISK_ACCEPTABILITY",
        "MATERIAL_ACTIONS_REQUIRE_DOWNSIDE_STRESS_AND_WORST_PLAUSIBLE_CASE",
        "THIN_TAIL_ASSUMPTIONS_MUST_NOT_BE_SILENTLY_APPLIED_TO_HEAVY_TAIL_MARKET_BEHAVIOR"
      ]
    },
    {
      "id": "UNCERTAINTY_AWARE_ABSTENTION",
      "severity": "P0",
      "states": ["ACT", "HOLD", "ABSTAIN", "SEEK_MORE_EVIDENCE"],
      "rules": [
        "NO_FORCED_ACTION_WHEN_DECISION_UNCERTAINTY_EXCEEDS_POLICY_CEILING",
        "ABSTENTION_IS_A_VALID_AUTONOMOUS_OUTPUT",
        "MISSING_DECISION_CRITICAL_EVIDENCE_MAY_TRIGGER_SEEK_MORE_EVIDENCE"
      ]
    },
    {
      "id": "SCENARIO_AND_MODEL_DISAGREEMENT_ROBUSTNESS",
      "severity": "P1_P0_FOR_HIGH_IMPACT",
      "rules": [
        "HIGH_IMPACT_ACTION_MUST_REPORT_CHAMPION_CHALLENGER_DISAGREEMENT",
        "ACTION_MUST_NOT_DEPEND_ON_SINGLE_FRAGILE_SCENARIO",
        "MATERIAL_RANK_REVERSAL_ACROSS_PLAUSIBLE_SCENARIOS_TRIGGERS_HOLD_OR_SHADOW_ONLY"
      ]
    },
    {
      "id": "VALUE_OF_INFORMATION_AND_DELAY",
      "severity": "P1",
      "rules": [
        "AUTONOMY_MUST_COMPARE_ACT_NOW_VALUE_WITH_EXPECTED_VALUE_OF_ADDITIONAL_INFORMATION",
        "DELAY_COST_AND_INFORMATION_GAIN_MUST_BOTH_BE_EXPLICIT",
        "MORE_DATA_IS_NOT_AUTOMATICALLY_BETTER_WHEN_DELAY_DESTROYS_DECISION_VALUE"
      ]
    },
    {
      "id": "REVERSIBILITY_AND_IRREVERSIBILITY_ASYMMETRY",
      "severity": "P0",
      "rules": [
        "IRREVERSIBLE_OR_HIGH_BLAST_RADIUS_ACTIONS_REQUIRE_STRONGER_EVIDENCE_THAN_REVERSIBLE_SHADOW_ACTIONS",
        "ROLLBACKABILITY_MUST_BE_PART_OF_DECISION_UTILITY",
        "PRODUCTION_PUBLIC_LEGAL_SECURITY_OR_SPEND_ACTIONS_REMAIN_EXPLICITLY_GATED"
      ]
    }
  ],
  "truth_ceiling": {
    "synthetic_or_control_evidence": "NON_PROMOTABLE_TO_EMPIRICAL_PASS",
    "live_mutation": "DISABLED_UNTIL_SEPARATE_ACTIVATION_GATE",
    "production": "HOLD",
    "public": "HOLD",
    "g5": "EXPLICIT_APPROVAL_REQUIRED"
  }
}
