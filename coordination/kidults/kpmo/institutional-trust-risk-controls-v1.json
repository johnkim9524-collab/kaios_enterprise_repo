{
  "id": "kidults-institutional-trust-risk-controls-v1",
  "version": "1.0.0",
  "status": "ACTIVE",
  "canonical_main_binding": "PROTECTED_MAIN_HEAD_AT_READ",
  "operating_principles": ["AUTONOMOUS", "GLOBAL", "IRREPLACEABLE_VALUE", "TRANSPARENT"],
  "controls": [
    {
      "id": "BENCHMARK_CAPTURE",
      "severity": "P0_P1",
      "rules": [
        "NO_SINGLE_BENCHMARK_MAY_DEFINE_GLOBAL_TRUTH_OR_PROMOTION_ELIGIBILITY",
        "BENCHMARK_CONSTRUCTION_SCOPE_METHODOLOGY_AND_LIMITATIONS_MUST_BE_VERSIONED_AND_DISCLOSED",
        "BENCHMARK_DEPENDENCY_AND_PROVIDER_CONCENTRATION_MUST_BE_REPORTED",
        "MATERIAL_BENCHMARK_CHANGE_REQUIRES_RECALIBRATION_AND_OUT_OF_SAMPLE_CHECK"
      ]
    },
    {
      "id": "METHODOLOGY_CAPTURE",
      "severity": "P0",
      "rules": [
        "METHODOLOGY_CHANGE_REQUIRES_VERSIONED_RATIONALE_EXPECTED_IMPACT_AND_ROLLBACK_TARGET",
        "NO_PROVIDER_CUSTOMER_OR_INTERNAL_STAKEHOLDER_MAY_WEAKEN_EVIDENCE_RIGHTS_OR_INDEPENDENCE_GATES",
        "HIGH_IMPACT_METHOD_CHANGES_REQUIRE_METHOD_DIVERSITY_OR_CHALLENGER_REVIEW",
        "METHODOLOGY_CHANGE_CANNOT_RETROACTIVELY_REWRITE_PUBLISHED_HISTORICAL_TRUTH"
      ]
    },
    {
      "id": "GOVERNANCE_CAPTURE",
      "severity": "P0",
      "rules": [
        "NO_SINGLE_ROLE_MAY_CREATE_EVIDENCE_APPROVE_ASSESSMENT_AND_AUTHORIZE_RELEASE_FOR_THE_SAME_MATERIAL_CLAIM",
        "SEPARATION_OF_DUTIES_MUST_SURVIVE_URGENT_OR_BREAK_GLASS_PATHS",
        "CONFLICT_OF_INTEREST_STATE_MUST_BE_EXPLICIT_FOR_MATERIAL_DECISIONS",
        "GOVERNANCE_EXCEPTION_REQUIRES_SCOPE_REASON_EXPIRY_AND_IMMUTABLE_AUDIT"
      ]
    },
    {
      "id": "INSIDER_COLLUSION",
      "severity": "P0",
      "rules": [
        "TWO_PERSON_OR_MULTI_ROLE_APPROVAL_DOES_NOT_PROVE_INDEPENDENCE_WHEN_ACTORS_SHARE_CONFLICT_OR_CONTROL_PATH",
        "MATERIAL_MANUAL_ADJUSTMENT_REQUIRES_BEFORE_AFTER_DIGEST_REASON_AND_INDEPENDENT_REVIEW",
        "REPEATED_OVERRIDE_OR_EXCEPTION_PATTERNS_REQUIRE_CORRELATION_REVIEW",
        "NO_HUMAN_ACTION_MAY_SILENTLY_MUTATE_EMPIRICAL_EVIDENCE_OR_CONFIDENCE_HISTORY"
      ]
    },
    {
      "id": "AUDIT_EVIDENCE_FORGERY",
      "severity": "P0",
      "required_bindings": ["CONTENT_DIGEST", "LINEAGE_DIGEST", "METHOD_VERSION", "RIGHTS_STATE", "TIME_STATE", "OPERATOR_OR_AUTOMATION_ID", "PREVIOUS_RECORD_HASH"],
      "rules": [
        "AUDIT_RECORD_EXISTENCE_NE_AUDIT_RECORD_AUTHENTICITY",
        "MATERIAL_AUDIT_RECORDS_MUST_BE_TAMPER_EVIDENT_AND_CHAIN_BOUND",
        "REGENERATED_AUDIT_RECORDS_MUST_BE_DISTINGUISHABLE_FROM_ORIGINAL_EVENT_RECORDS",
        "MISSING_OR_BROKEN_AUDIT_CHAIN_HOLDS_AFFECTED_PROMOTION_OR_RELEASE"
      ]
    },
    {
      "id": "SELECTIVE_DISCLOSURE",
      "severity": "P0_P1",
      "rules": [
        "POSITIVE_CLAIMS_MUST_NOT_OMIT_MATERIAL_LIMITATIONS_CONTRADICTORY_EVIDENCE_OR_COVERAGE_GAPS",
        "DISCLOSURE_PACKAGE_MUST_BIND_CLAIM_CONFIDENCE_LIMITATIONS_AND_MATERIAL_COUNTEREVIDENCE",
        "INTERNAL_EXECUTIVE_AND_EXTERNAL_PROJECTION_MAY_DIFFER_IN_DETAIL_BUT_NOT_IN_TRUTH_STATE",
        "UNKNOWN_OR_NOT_VERIFIED_MUST_NOT_BE_HIDDEN_BY_AGGREGATION"
      ]
    },
    {
      "id": "STRATEGIC_DISCLOSURE_TIMING",
      "severity": "P1_P0_BEFORE_EXTERNAL_SCALE",
      "rules": [
        "DISCLOSURE_TIMING_MUST_NOT_CREATE_FALSE_FRESHNESS_OR_HIDE_KNOWN_INVALIDATION",
        "KNOWN_MATERIAL_CORRECTION_OR_RIGHTS_REVOCATION_REQUIRES_PROMPT_STATE_CHANGE_NOT_SCHEDULED_DELAY_FOR_BUSINESS_CONVENIENCE",
        "SNAPSHOT_AND_PUBLICATION_TIMES_MUST_BE_DISTINCT_AND_AUDITABLE",
        "TIME_DELAYED_PUBLICATION_MUST_PRESERVE_AS_OF_TRUTH_AND_CURRENT_LIMITATION_STATE"
      ]
    }
  ],
  "trust_ceiling": {
    "control_or_synthetic_evidence": "NON_PROMOTABLE_TO_EMPIRICAL_PASS",
    "manual_override": "CANNOT_WEAKEN_TRUTH_RIGHTS_OR_G5_GATES",
    "public": "HOLD",
    "production": "HOLD",
    "g5": "EXPLICIT_APPROVAL_REQUIRED"
  }
}
