{
  "id": "digitalocean-staging-bootstrap-contract-v1",
  "version": "1.0.0",
  "parent_issue": 899,
  "environment": "STAGING",
  "target": {
    "droplet_id_variable": "DIGITALOCEAN_STAGING_DROPLET_ID",
    "public_ip_variable": "KIDULTS_STAGING_PUBLIC_IP",
    "private_ip_variable": "KIDULTS_STAGING_PRIVATE_IP",
    "expected_name": "ih-staging-01",
    "expected_region": "sgp1"
  },
  "bootstrap_policy": {
    "idempotent": true,
    "versioned": true,
    "audited": true,
    "staging_only": true,
