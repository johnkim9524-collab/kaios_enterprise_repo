{
  "id": "kidults-kir-modular-architecture-v1",
  "version": "1.0.0",
  "internal_root": "scripts/kidults/runtime/kir",
  "public_entrypoint": "scripts/kidults/runtime/kir-runtime-kernel-v1.mjs",
  "public_entrypoint_max_nonempty_lines": 50,
  "public_entrypoint_internal_dependencies": [
    "constants",
    "evaluator",
    "snapshot"
  ],
  "modules": [
    {
      "id": "constants",
      "file": "scripts/kidults/runtime/kir/constants-v1.mjs",
      "dependencies": [],
      "external_imports": [],
      "builtin_imports": [],
      "max_nonempty_lines": 90
    },
    {
      "id": "snapshot",
      "file": "scripts/kidults/runtime/kir/snapshot-v1.mjs",
      "dependencies": ["constants"],
      "external_imports": [],
      "builtin_imports": ["node:fs", "node:crypto", "node:util"],
      "max_nonempty_lines": 80
    },
    {
      "id": "graph",
      "file": "scripts/kidults/runtime/kir/graph-v1.mjs",
      "dependencies": ["constants"],
      "external_imports": ["scripts/kidults/runtime/validate-kir-readiness-structure-v1.mjs"],
      "builtin_imports": [],
      "max_nonempty_lines": 140
    },
    {
      "id": "state-machine",
      "file": "scripts/kidults/runtime/kir/state-machine-v1.mjs",
      "dependencies": ["constants", "graph"],
      "external_imports": [],
      "builtin_imports": [],
      "max_nonempty_lines": 150
    },
    {
      "id": "evaluator",
      "file": "scripts/kidults/runtime/kir/evaluator-v1.mjs",
      "dependencies": ["constants", "graph", "snapshot", "state-machine"],
      "external_imports": [],
      "builtin_imports": [],
      "max_nonempty_lines": 180
    }
  ],
  "constraints": {
    "dependency_cycles_allowed": false,
    "internal_imports_outside_public_entrypoint_allowed": false,
    "module_cli_or_process_side_effects_allowed": false,
    "provider_calls_allowed": false,
    "database_writes_allowed": false,
    "deployment_allowed": false,
    "public_release": "HOLD",
    "production": "HOLD",
    "g5": "HOLD"
  }
}
