{
  "id": "kidults-postgres-external-one-shot-authorization-v1",
  "version": "1.0.0",
  "state": "IMPLEMENTED_NOT_ACTIVATED",
  "status": "BLOCKED_EXTERNAL_LEDGER_DEPLOYMENT_RESPONSE_KEY_PIN_SIGNED_READBACK_AND_POST_LANDING_CONFIG_READBACK",
  "issues": [240, 921],
  "environment": "STAGING",
  "purpose": "Replace reusable PostgreSQL activation state with an operation-specific authorization that is atomically consumed in an external durable ledger before any PostgreSQL, SSH, or provider credential is used or any provider connection begins.",
  "standing_activation": {
    "repository_variable": "KIDULTS_REMOTE_POSTGRES_AUTO_ACTIVATION_AUTHORIZED",
    "required_value": "false",
    "missing_value_behavior": "BLOCK",
    "true_value_behavior": "BLOCK_STANDING_AUTHORIZATION_FORBIDDEN",
    "may_authorize_provider_credentials": false
  },
  "external_readback_baseline": {
    "reported_at_implementation": true,
    "repository_variable_value": "false",
    "kidults_do_staging_ssh_environment_variable_shadow_present": false,
    "readback_reperformed_by_this_change": false,
    "configuration_mutated_by_this_change": false,
    "truth_boundary": "This records the KPMO-supplied control-plane read-back baseline for implementation. Exact post-landing GitHub read-back remains required before any grant or provider run."
  },
  "external_ledger": {
    "contract": "coordination/kidults/governance/external-one-shot-approval-ledger-v1.json",
    "contract_id": "external-one-shot-approval-ledger-v1",
    "contract_version": "1.0.0",
    "client": "scripts/governance/external-one-shot-approval-ledger-v1.mjs",
    "consume_environment": "kidults-approval-ledger-consume",
    "base_url_variable": "KIDULTS_APPROVAL_LEDGER_BASE_URL",
    "required_secrets": [
      "KIDULTS_APPROVAL_LEDGER_REQUEST_HMAC_KEY_B64"
    ],
    "required_public_variables": [
      "KIDULTS_APPROVAL_LEDGER_BASE_URL",
      "KIDULTS_APPROVAL_LEDGER_RESPONSE_ED25519_PUBLIC_KEY_B64"
    ],
    "response_signature": "ED25519_DETACHED_OVER_EXACT_RAW_BODY",
    "verification_key_format": "SPKI_DER_BASE64",
    "verification_key_digest_receipt_field": "verification_key_spki_sha256",
    "response_verification": {
      "algorithm": "Ed25519",
      "public_key_environment": "KIDULTS_APPROVAL_LEDGER_RESPONSE_ED25519_PUBLIC_KEY_B64",
      "public_key_spki_sha256": "UNPROVISIONED",
      "pin_source": "REPOSITORY_MACHINE_BINDING_AT_EXACT_CONTROL_SHA",
      "state": "BLOCKED_EXTERNAL_KEY_PROVISIONING_AND_REPOSITORY_PIN_LANDING",
      "github_private_signing_key_forbidden": true
    },
    "ledger_only_private_key_environment": "KIDULTS_APPROVAL_LEDGER_RESPONSE_ED25519_PRIVATE_KEY_B64",
    "ledger_private_key_allowed_in_github": false,
    "atomic_transition": "ACTIVE_TO_CONSUMED_COMPARE_AND_SWAP",
    "success_http_status": 201,
    "replay_http_status": 409,
    "expired_http_status": 410,
    "unknown_http_status": 404,
    "binding_mismatch_http_status": 422,
    "offline_or_ambiguous_behavior": "FAIL_CLOSED"
  },
  "workflow_inputs": {
    "approval_id": {
      "required": true,
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{7,127}$"
    },
    "approval_expires_at": {
      "required": true,
      "role": "EXPECTED_IMMUTABLE_LEDGER_BINDING_NOT_AUTHORITY",
      "format": "RFC3339_UTC",
      "maximum_seconds_after_readiness": 3600,
      "mismatch_behavior": "LEDGER_422_AND_NO_PROVIDER_CREDENTIAL_USE"
    }
  },
  "request_window": {
    "created_by_credential_free_job": true,
    "source_fixture_created_by": "ACTIVATION_READINESS_RECEIPT",
    "restore_created_by": "POST_SOURCE_FIXTURE_BINDING",
    "seconds": 600,
    "minimum_approval_seconds_remaining_at_consume_and_provider_start": 1800,
    "minimum_approval_seconds_remaining_at_signed_consumed_at": 1800,
    "operator_registers_exact_binding_before_environment_approval": true,
    "expired_window_behavior": "NO_LEDGER_WINNER_AND_NO_PROVIDER_CREDENTIAL_USE"
  },
  "operations": [
    {
      "operation_id": "KIDULTS_POSTGRES_SOURCE_FIXTURE_V1",
      "workflow": ".github/workflows/p0-remote-postgres-persistence-pitr.yml",
