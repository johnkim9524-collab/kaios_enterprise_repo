          "source_artifact_id",
          "source_artifact_digest",
          "source_receipt_sha256",
          "restore_operation_reference_sha256"
        ],
        "restore_operation_reference": "BOUND_NOT_VERIFIED",
        "resource_id_formula": "resource_id_prefix + lowercase_sha256_hex(canonical_json)",
        "target_digest_formula": "generic external-one-shot canonical target SHA-256"
      }
    }
  ],
  "required_request_bindings": [
