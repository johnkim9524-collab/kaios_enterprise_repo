{
  "id": "kidults-digitalocean-staging-portal-receipt-contract-v1",
  "version": "1.1.0",
  "issue": 921,
  "status": "REGISTERED_FAIL_CLOSED",
  "environment": "STAGING",
  "purpose": "Bind one exact source commit and workflow execution to deployment, remote localhost NO_PROJECTION health, and rollback evidence without treating local contract proof as remote deployment proof.",
  "target": {
    "hostname": "ih-staging-01",
    "user": "kidults-staging",
    "bind": "127.0.0.1:4173",
    "health_url": "http://127.0.0.1:4173/index.html",
    "public_bind": false
  },
  "evidence_classes": {
    "REMOTE_STAGING": {
      "description": "Evidence emitted by the pinned non-root DigitalOcean STAGING execution path.",
      "eligible_for_issue_921_remote_exit": true
    },
    "LOCALHOST_CONTRACT_PROOF": {
      "description": "Credential-free local execution of the same deploy and receipt code against 127.0.0.1.",
      "eligible_for_issue_921_remote_exit": false
    }
  },
  "bundle": {
    "remote_root": "/home/kidults-staging/kidults-runtime/audit/portal-r001-deployments/<deployment_id>",
    "required_for_deployed_outcome": [
      "deploy-receipt.json",
      "health-receipt.json",
      "rollback-receipt.json",
      "index.html"
    ],
    "required_for_rolled_back_outcome": [
      "rollback-receipt.json",
      "rollback-index.html"
    ],
    "stale_evidence_control": "Every receipt must match the caller-supplied deployment_id, source_commit_sha, workflow_run_id, workflow_run_attempt, evidence_class, environment, hostname, user, and bind.",
    "artifact_retention_days": 30
  },
  "common_required_fields": [
    "receipt_contract_id",
    "receipt_type",
    "deployment_id",
    "source_commit_sha",
    "workflow_run_id",
    "workflow_run_attempt",
    "evidence_class",
    "remote_target_observed",
    "environment",
    "hostname",
    "user",
    "bind",
    "observed_at",
    "public_bind",
    "production_touch",
    "raw_provider_ingestion",
    "real_business_workload",
    "g5"
  ],
  "deploy_receipt": {
    "receipt_type": "DEPLOYMENT",
    "required_remote_state": "DEPLOYED_VERIFIED",
    "required_local_contract_proof_state": "VERIFIED_PASS",
    "required_fields": [
      "release_path",
      "previous_release",
      "release_digest",
      "server_pid",
      "health_receipt",
      "rollback_receipt"
    ]
  },
  "health_receipt": {
    "receipt_type": "LOCALHOST_HEALTH",
    "required_state": "VERIFIED_PASS",
    "request_url": "http://127.0.0.1:4173/index.html",
    "required_http_status": 200,
    "required_portal_state": "NO_PROJECTION",
    "required_markers": [
      "data-release=\"portal-release-001\"",
      "data-state=\"NO_PROJECTION\"",
      "Read the market.",
      "Know the evidence."
    ],
    "required_fields": [
      "request_url",
      "http_status",
      "body_sha256",
      "portal_state",
      "markers"
    ]
  },
  "rollback_receipt": {
    "receipt_type": "ROLLBACK",
    "deployed_action": "ARMED_NOT_EXECUTED",
    "rolled_back_action": "EXECUTED",
    "issue_921_exit_requires_previous_target": true,
    "required_fields": [
      "rollback_action",
      "rollback_target_available",
      "rollback_target",
      "rollback_target_digest",
      "rollback_target_digest_verified",
      "restored_release_digest",
      "rollback_status",
      "failed_release",
      "trigger_exit_code"
    ],
    "deployed_outcome": {
      "required_state_when_target_available": "VERIFIED_PASS",
      "required_status_when_target_available": "ARMED",
      "rollback_target_digest_verified": true,
      "pre_cutover_without_previous_target": "VERIFIED_FAIL_NO_CUTOVER",
      "state_without_previous_target": "BLOCKED",
      "status_without_previous_target": "NO_PREVIOUS_RELEASE",
      "required_trigger_exit_code": 0
    },
    "rolled_back_outcome": {
      "required_state": "VERIFIED_PASS",
      "required_status": "RESTORED",
      "rollback_target_digest_verified": true,
      "restored_release_digest_must_equal_rollback_target_digest": true,
      "trigger_exit_code_must_be_nonzero": true,
      "required_restored_health_markers": [
        "data-release=\"portal-release-001\"",
        "data-state=\"NO_PROJECTION\""
      ]
    }
  },
  "digest_semantics": {
    "algorithm": "SHA-256",
    "format": "sha256:<64 lowercase hexadecimal characters>",
    "release_digest": "Digest of the sorted relative-path sha256sum manifest for regular files in the release directory.",
    "rollback_target_digest": "Captured before candidate preparation, revalidated immediately before cutover, before rollback, and after restored localhost health.",
    "body_sha256": "Digest of the exact localhost HTTP response body stored in the workflow artifact."
  },
  "safety_boundaries": {
    "no_sudo": true,
    "no_package_mutation": true,
    "no_firewall_mutation": true,
    "no_dns_mutation": true,
    "public_intelligence": "HOLD",
    "production": "HOLD",
    "g5": "HOLD",
    "credentials_in_receipts": false
  },
  "authority_boundary": {
    "local_contract_proof": "AUTHORIZED_REVERSIBLE_NON_PRODUCTION",
    "remote_deployment": "NOT_PERFORMED_BY_THIS_CHANGE",
    "production_g5": "HOLD"
  },
  "platform_principle_effects": {
    "autonomous_effect": "A credential-free exact-head validator runs automatically on pull requests and protected-main changes; the privileged deploy remains separately gated.",
    "global_effect": "No global coverage or intelligence claim is created; the Portal remains NO_PROJECTION.",
    "irreplaceable_value_effect": "Provider-independent repository-owned receipts preserve release, health, and rollback lineage.",
    "transparency_effect": "Exact commit, workflow run, deployment ID, localhost body digest, rollback target, and evidence class are machine-validated and stale bundles fail closed."
  }
}
