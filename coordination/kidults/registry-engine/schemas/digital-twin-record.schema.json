{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kidults://registry-engine/digital-twin-record.schema.json",
  "title": "KIDULTS Digital Twin Current State",
  "type": "object",
  "required": ["id","record_type","version","status","twin_id","program_status","registry_health","current_milestone_id","current_baseline_snapshot_id","track_states","production_state","generated_at","created_by"],
  "properties": {
    "record_type": {"const":"digital_twin"},
    "twin_id": {"type":"string","pattern":"^TWIN-[0-9]{4}$"},
    "status": {"enum":["CURRENT","SUPERSEDED","ARCHIVED"]},
    "track_states": {"type":"object","required":["A","B","C","D"]}
  },
  "additionalProperties": true
}
