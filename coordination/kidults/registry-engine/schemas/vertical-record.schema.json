{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://kidults.com/schemas/vertical-record.schema.json",
  "title":"KIDULTS Core Vertical Record",
  "type":"object",
  "required":["id","record_type","version","status","order","display_name","slug","representative_scope","stable_structure","created_by","approved_by"],
  "properties":{
    "record_type":{"const":"core_vertical"},
    "order":{"type":"integer","minimum":1,"maximum":8},
    "stable_structure":{"const":true},
    "representative_scope":{"type":"array","minItems":1}
  },
  "additionalProperties":true
}
