    "lawful_empirical_admission_authorized_by_this_receipt_alone": false,
    "requires_atomic_current_sold_admission": true,
    "requires_separate_append_only_ledger_gate": true,
    "requires_track_b_exact_pair": true,
    "public": "HOLD",
