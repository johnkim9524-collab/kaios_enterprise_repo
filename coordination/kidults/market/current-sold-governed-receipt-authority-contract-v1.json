    "EXPECTED_SOURCE_SHA",
    "EXPECTED_CANONICAL_RUN_ID",
    "EXPECTED_PURPOSE_PRIVATE_CURRENT_SOLD"
  ],
  "required_registry_invariants": [
    "EXACT_SCHEMA_VERSION",
    "NONEMPTY_ACQUISITIONS_AND_RIGHTS",
    "GLOBALLY_UNIQUE_RECEIPT_IDS",
    "ALL_RECEIPTS_PASS",
    "ALL_RECEIPTS_BIND_EXPECTED_SOURCE_SHA_AND_RUN",
    "EVERY_ACQUISITION_SOURCE_HAS_EXACT_RIGHTS_COVERAGE",
    "NO_EXTRA_RIGHTS_SOURCE",
    "EXACT_SORTED_RECEIPT_SET_DIGESTS"
  ],
  "required_authority_invariants": [
    "ED25519_SIGNATURE_VALID",
    "ACTIVE_KEY_AND_ISSUER_BINDING",
