{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kidults-current-sold-batch-envelope-v1",
  "title": "KIDULTS Current-SOLD Batch Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "created_at",
    "source_sha",
    "canonical_run_id",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": "current-sold-batch-envelope-v1"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "canonical_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content_digest",
          "canonical_object_id",
          "source_id",
          "source_event_id",
          "source_url",
          "source_owner",
          "venue",
          "transaction_status",
          "sold_at",
          "observed_at",
          "realized_consideration",
          "currency",
          "fee_semantics",
          "provenance_digest",
          "acquisition_receipt_id",
          "rights_receipt_id",
          "rights_decision",
          "source_sha",
          "canonical_run_id"
        ],
        "properties": {
          "content_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "canonical_object_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_event_id": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "source_owner": {
            "type": "string",
            "minLength": 1
          },
          "venue": {
            "type": "string",
            "minLength": 1
          },
          "transaction_status": {
            "const": "SOLD"
          },
          "sold_at": {
            "type": "string",
            "format": "date-time"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "realized_consideration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "hammer_price": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "all_in_price": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "normalized_price": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "normalized_currency": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{3}$"
          },
          "fee_semantics": {
            "enum": [
              "HAMMER",
              "ALL_IN",
              "SOURCE_REPORTED_UNKNOWN_FEE_BASIS"
            ]
          },
          "lot_or_listing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "acquisition_receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "rights_receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "rights_decision": {
            "const": "ALLOW_PRIVATE_CURRENT_SOLD"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "correction_state": {
            "enum": [
              "ORIGINAL",
              "CORRECTED"
            ]
          },
          "supersedes_event_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^cs_[a-f0-9]{24}$"
          },
          "supersedes_content_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "source_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "canonical_run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
          }
        }
      },
      "maxItems": 10000
    }
  }
}
