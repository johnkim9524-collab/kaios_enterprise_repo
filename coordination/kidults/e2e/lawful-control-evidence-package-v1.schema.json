{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kidults.example/schemas/lawful-control-evidence-package-v1.schema.json",
  "title": "KIDULTS lawful-derived non-promotable control Evidence Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "fixture_type",
    "evidence_package_id",
    "package_status",
    "as_of",
    "bound_snapshot_id",
    "source_observation",
    "rights",
    "evidence_records",
    "canonical_handoff_eligible",
    "official_track_b_started",
    "promotable",
    "real_product_value_proof",
    "approved_projection",
    "publication_authorized",
    "production_authorized",
    "public_release",
    "production",
    "g5",
    "evidence_package_payload_sha256",
    "pair_digest"
  ],
  "properties": {
    "record_type": {"const": "kidults_lawful_control_evidence_package"},
    "schema_version": {"const": "1.0.0"},
    "fixture_type": {"const": "LAWFUL_SOURCE_NON_PROMOTABLE_CONTROL"},
    "evidence_package_id": {"type": "string", "minLength": 1},
    "package_status": {"const": "CONTROL_CONTENT_ADDRESSED_NOT_CANONICAL_IMMUTABLE"},
    "as_of": {"type": "string", "format": "date-time"},
    "bound_snapshot_id": {"type": "string", "minLength": 1},
    "source_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "observation_id", "source_id", "source_projection_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "observation_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "source_projection_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collect", "store", "transform", "display", "redistribute", "sell", "review_due_at", "legal_conclusion_asserted", "independent_legal_review_complete", "evidence_refs"],
      "properties": {
        "collect": {"const": "ALLOW"},
        "store": {"const": "ALLOW"},
        "transform": {"const": "ALLOW"},
        "display": {"const": "UNKNOWN"},
        "redistribute": {"const": "UNKNOWN"},
        "sell": {"const": "UNKNOWN"},
        "review_due_at": {"type": "string", "format": "date-time"},
        "legal_conclusion_asserted": {"const": false},
        "independent_legal_review_complete": {"const": false},
        "evidence_refs": {
          "const": [
            "https://www.state.gov/copyright-information",
            "https://ceac.state.gov/ceacstattracker/Common/Copyright.aspx",
            "https://travel.state.gov/content/travel/en/copyright-disclaimer.html"
          ]
        }
      }
    },
    "evidence_records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "admission_state", "evidence_class", "source_id", "source_owner_id", "factual_origin_id", "scope_id", "domain_id", "internal_normalized_facts", "price_role", "semantic_boundary", "provenance", "claim_ceiling", "reference_only", "signal_eligible", "index_eligible", "customer_claim_authorized"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "admission_state": {"const": "ADMITTED_CONTROL_REFERENCE_ONLY"},
          "evidence_class": {"const": "AUCTION_RESULT_REFERENCE"},
          "source_id": {"type": "string", "minLength": 1},
          "source_owner_id": {"type": "string", "minLength": 1},
          "factual_origin_id": {"type": "string", "minLength": 1},
          "scope_id": {"type": "string", "minLength": 1},
          "domain_id": {"type": "string", "minLength": 1},
          "internal_normalized_facts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "object_identifiers", "camera_quantity", "lot_quantity", "condition", "event_state", "event_at", "observed_at", "terminal_display_amount", "currency", "bid_count"],
            "properties": {
              "title": {"const": "NIKON CAMERA"},
              "object_identifiers": {"const": ["Nikon D5600", "Nikon D90"]},
              "camera_quantity": {"const": 2},
              "lot_quantity": {"const": 1},
              "condition": {"const": "Usable"},
              "event_state": {"const": "SOLD"},
              "event_at": {"const": "2024-06-29T12:00:00Z"},
              "observed_at": {"type": "string", "format": "date-time"},
              "terminal_display_amount": {"const": 2110},
              "currency": {"const": "QAR"},
              "bid_count": {"const": 101}
            }
          },
          "price_role": {"const": "TERMINAL_HIGHEST_BID_DISPLAY_AMOUNT_NOT_CONFIRMED_SETTLEMENT_OR_ALL_IN_REALIZED"},
          "semantic_boundary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verified_sold_event", "hammer_price_confirmed", "settlement_confirmed", "current_price", "liquidity_or_time_to_sale", "collector_market_representativeness_verified"],
            "properties": {
              "verified_sold_event": {"const": false},
              "hammer_price_confirmed": {"const": false},
              "settlement_confirmed": {"const": false},
              "current_price": {"const": false},
              "liquidity_or_time_to_sale": {"const": false},
              "collector_market_representativeness_verified": {"const": false}
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_url", "source_projection_sha256", "raw_live_source_snapshot_verified", "lineage_digest_role", "source_schema_version", "source_event_id", "source_lot_id"],
            "properties": {
              "source_url": {"const": "https://online-auction.state.gov/en-US/Auction/Lot/fdc79e90-95ac-452e-8f9b-ac91aede6e3d?auctionId=13251474-ac4c-49d5-b3dc-9c9b0cb181e3"},
              "source_projection_sha256": {"const": "sha256:dcd433fa8d320a0e3e6a22c3425e72b70988815dfb5c69514517588e009f37b5"},
              "raw_live_source_snapshot_verified": {"const": false},
              "lineage_digest_role": {"const": "NORMALIZED_SOURCE_PROJECTION_DIGEST_NOT_RAW_SOURCE_PAYLOAD"},
              "source_schema_version": {"const": "state-department-online-auction-fact-projection-v1"},
              "source_event_id": {"const": "13251474-ac4c-49d5-b3dc-9c9b0cb181e3"},
              "source_lot_id": {"const": "fdc79e90-95ac-452e-8f9b-ac91aede6e3d"}
            }
          },
          "claim_ceiling": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allowed", "forbidden"],
            "properties": {
              "allowed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "forbidden": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          },
          "reference_only": {"const": true},
          "signal_eligible": {"const": false},
          "index_eligible": {"const": false},
          "customer_claim_authorized": {"const": false}
        }
      }
    },
    "canonical_handoff_eligible": {"const": false},
    "official_track_b_started": {"const": false},
    "promotable": {"const": false},
    "real_product_value_proof": {"const": false},
    "approved_projection": {"const": false},
    "publication_authorized": {"const": false},
    "production_authorized": {"const": false},
    "public_release": {"const": "HOLD"},
    "production": {"const": "HOLD"},
    "g5": {"const": "HOLD"},
    "evidence_package_payload_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "pair_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
