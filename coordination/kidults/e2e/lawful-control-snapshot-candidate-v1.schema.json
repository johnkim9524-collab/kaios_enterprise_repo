{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kidults.example/schemas/lawful-control-snapshot-candidate-v1.schema.json",
  "title": "KIDULTS lawful-derived non-promotable control Snapshot Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "fixture_type",
    "candidate_class",
    "snapshot_id",
    "snapshot_status",
    "as_of",
    "source_observation",
    "bound_evidence_package_id",
    "evidence_state",
    "canonical_handoff_eligible",
    "official_track_b_started",
    "promotable",
    "real_product_value_proof",
    "approved_projection",
    "publication_authorized",
    "production_authorized",
    "public_release",
    "production",
    "g5",
    "known_limitations",
    "candidate_payload_sha256",
    "pair_digest"
  ],
  "properties": {
    "record_type": {"const": "kidults_lawful_control_snapshot_candidate"},
    "schema_version": {"const": "1.0.0"},
    "fixture_type": {"const": "LAWFUL_SOURCE_NON_PROMOTABLE_CONTROL"},
    "candidate_class": {"const": "CONTROL_ONLY_NOT_CANONICAL_CANDIDATE"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "snapshot_status": {"const": "CONTROL_ONLY"},
    "as_of": {"type": "string", "format": "date-time"},
    "source_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "observation_id", "source_id", "source_projection_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "observation_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "source_projection_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "bound_evidence_package_id": {"type": "string", "minLength": 1},
    "evidence_state": {"const": "REFERENCE_ONLY_CONTROL_INPUT"},
    "canonical_handoff_eligible": {"const": false},
    "official_track_b_started": {"const": false},
    "promotable": {"const": false},
    "real_product_value_proof": {"const": false},
    "approved_projection": {"const": false},
    "publication_authorized": {"const": false},
    "production_authorized": {"const": false},
    "public_release": {"const": "HOLD"},
    "production": {"const": "HOLD"},
    "g5": {"const": "HOLD"},
    "known_limitations": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidate_payload_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "pair_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
