{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kidults.example/schemas/handoff.schema.json",
  "title": "KIDULTS Cross-Track Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_id",
    "from_track",
    "to_track",
    "snapshot_id",
    "artifact_reference",
    "artifact_version",
    "requested_action",
    "deadline",
    "known_limitations",
    "acceptance_criteria",
    "state",
    "created_at"
  ],
  "properties": {
    "handoff_id": {"type": "string", "pattern": "^HO-[A-Z0-9-]+$"},
    "from_track": {"enum": ["A", "B", "C", "INTEGRATION"]},
    "to_track": {"enum": ["A", "B", "C", "INTEGRATION", "PROGRAM_OWNER"]},
    "snapshot_id": {"type": "string", "minLength": 1},
    "artifact_reference": {"type": "string", "minLength": 1},
    "artifact_version": {"type": "string", "minLength": 1},
    "requested_action": {"type": "string", "minLength": 1},
    "deadline": {"type": "string", "format": "date-time"},
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "state": {"enum": ["requested", "accepted", "rejected", "correction_requested", "completed", "cancelled"]},
    "created_at": {"type": "string", "format": "date-time"},
    "response_at": {"type": ["string", "null"], "format": "date-time"},
    "response_note": {"type": ["string", "null"]}
  }
}