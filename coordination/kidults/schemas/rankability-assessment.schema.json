{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kidults.example/schemas/rankability-assessment.schema.json",
  "title": "KIDULTS Rankability Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "snapshot_id",
    "assessed_at",
    "assessor",
    "methodology_version",
    "gate_state",
    "blocking_dimensions",
    "exit_criteria",
    "stability_summary",
    "provider_spend_recommendation",
    "residual_risks",
    "evidence_references"
  ],
  "properties": {
    "assessment_id": {"type": "string"},
    "snapshot_id": {"type": "string"},
    "assessed_at": {"type": "string", "format": "date-time"},
    "assessor": {"type": "string"},
    "methodology_version": {"type": "string"},
    "gate_state": {"enum": ["blocked", "conditional", "publishable"]},
    "blocking_dimensions": {"type": "array", "items": {"type": "string"}},
    "exit_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "measure", "target"],
        "properties": {
          "criterion": {"type": "string"},
          "measure": {"type": "string"},
          "target": {"type": "string"}
        }
      }
    },
    "stability_summary": {"type": "object"},
    "provider_spend_recommendation": {"enum": ["not_ready", "targeted_poc_only", "ready_for_evaluation"]},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "evidence_references": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}