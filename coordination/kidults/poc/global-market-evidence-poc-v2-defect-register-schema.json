{
  "id":"global-market-evidence-poc-v2-defect-register-schema",
  "version":"1.0.0",
  "required_fields":["defect_id","scope_id","product_id","diagnostic_dimension","severity","evidence_refs","observed_behavior","expected_behavior","customer_decision_impact","north_star_impact","root_cause_class","remediation","owner_track","status"],
