    "evidence_class",
    "removal_test_state",
    "replacement_path",
    "canonical_identity_state",
    "methodology_state",
    "confidence_history_state",
    "downstream_contract_state",
    "switching_lead_time",
    "residual_dependency",
    "decision"
  ],
  "decision_states": ["PASS_FOR_REPLACEABLE_USE", "HOLD_FOR_INTERNALIZATION", "NO_GO_DEPENDENCY"],
  "non_bypass": {
    "external_spend": "EXPLICIT_APPROVAL_REQUIRED",
    "contract_acceptance": "EXPLICIT_APPROVAL_REQUIRED",
    "credential_activation": "EXPLICIT_APPROVAL_REQUIRED",
    "production": "HOLD",
    "g5": "EXPLICIT_APPROVAL_REQUIRED"
  }
}
