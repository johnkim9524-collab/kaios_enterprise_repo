      "security_privacy_and_audit",
      "assignment_novation_and_change_of_control"
    ],
    "provider_requested_call_response": "DECLINE_POLITELY_AND_REQUEST_THE_RELEVANT_INFORMATION_TERM_SHEET_SAMPLE_SCHEMA_AND_REDLINE_BY_EMAIL",
    "provider_written_refusal_outcome": "HOLD_OR_DROP_AND_ACTIVATE_REPLACEMENT_PATH",
    "agent_must_not": [
      "OFFER_A_CALL",
