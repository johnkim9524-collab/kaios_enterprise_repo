{
  "id": "KIDULTS_CURRENT_SOLD_SAMPLE_GOVERNANCE_V1",
  "version": "1.1.0",
  "purpose": "Pre-register claim-specific sample sizes and stopping rules. Sample size never substitutes for per-record rights or schema admission.",
  "rights_gate": {
    "mode": "CENSUS_NOT_SAMPLE",
    "required_for_every_event": true,
    "unknown_or_expired_is": "HOLD",
    "critical_rights_defect_tolerance": 0
  },
  "statistical_method": {
    "interval": "ONE_SIDED_EXACT_CLOPPER_PEARSON_UPPER_BOUND",
    "confidence": 0.99,
    "alpha": 0.01,
    "zero_failure_formula": "ceil(log(alpha) / log(1 - defect_tolerance))",
    "optional_stopping": false,
    "threshold_change_after_observation": false,
    "independence_rule": "Track B independently recomputes effective_n after duplicate-cluster, retry, owner/source/time correlation review; raw record count cannot substitute for effective_n",
    "pass_formula": "exact_one_sided_CP_UCB(defects,effective_n) <= tier_tolerance AND critical_defects=0 AND rights_census=PASS AND schema_census=PASS AND coverage_gate=PASS AND concentration_gate=PASS"
  },
  "tiers": [
    {"id":"CONTROL_ONLY_FUNCTIONAL","purpose":"DETERMINISTIC_PLUMBING_REPLAY","claim_target":"DATED_OBSERVED_SOLD_TRANSACTION","min_n":1,"max_n":300,"critical_defect_tolerance":0,"statistical_claim":false},
    {"id":"CANARY","purpose":"SCHEMA_AND_BOUNDARY_SMOKE","claim_target":"DATED_OBSERVED_SOLD_TRANSACTION","min_n":5,"max_n":5,"critical_defect_tolerance":0,"statistical_claim":false},
    {"id":"BOUNDED_FUNCTIONAL_PILOT","purpose":"BOUNDED_REAL_DATA_END_TO_END_FUNCTIONAL_PROOF","claim_target":"DATED_OBSERVED_SOLD_TRANSACTION","min_n":30,"max_n":120,"critical_defect_tolerance":0,"statistical_claim":false,"coverage_required":true},
    {"id":"ADAPTER_QUALIFICATION","purpose":"SOURCE_PIPELINE_RELIABILITY","claim_target":"DATED_OBSERVED_SOLD_TRANSACTION","defect_tolerance":0.01,"zero_failure_n":459,"min_n":459,"max_n":1000,"critical_defect_tolerance":0,"statistical_claim":true},
    {"id":"PRIVATE_E2E","purpose":"BOUNDED_INTERNAL_PRODUCT_PROOF","claim_target":"DATED_OBSERVED_SOLD_TRANSACTION","defect_tolerance":0.0025,"zero_failure_n":1840,"min_n":1840,"max_n":3000,"critical_defect_tolerance":0,"statistical_claim":true,"min_independent_ultimate_owners":2,"max_owner_share":0.70},
    {"id":"BETA_RELIABILITY","purpose":"RELEASE_EVIDENCE_RELIABILITY","claim_target":"DATED_OBSERVED_SOLD_TRANSACTION","defect_tolerance":0.001,"zero_failure_n":4603,"min_n":4603,"max_n":10000,"critical_defect_tolerance":0,"statistical_claim":true,"min_independent_ultimate_owners":3,"max_owner_share":0.50}
  ],
  "defect_taxonomy": {"CRITICAL":{"tolerance":0,"examples":["illegal_or_unlicensed_use","unknown_provenance","wrong_identity","non_sold_labeled_sold","tampering"]},"MAJOR_A":{"tolerance":0.001},"MAJOR_B":{"tolerance":0.0025},"OPERATIONAL":{"tolerance":0.01},"MINOR_UI":{"tolerance":"separate_ux_data_quality_slo"}},
  "coverage_gate": {
    "separate_from_sample_size": true,
    "required_strata": ["ultimate_owner", "source", "vertical", "territory", "currency", "time_bucket"],
    "duplicate_cluster_is_independent_sample": false,
    "market_representativeness_inferred_from_n": false
  },
  "failure_accounting": {
    "parse_drop_counts_as": "FAILURE",
    "timeout_counts_as": "FAILURE",
    "retry_is_new_independent_success": false,
    "duplicate_event_counts_as": "INVALID_AND_HOLD"
  },
  "claim_ceiling": {
    "bounded_functional_pilot": "BOUNDED_PRIVATE_FUNCTIONAL_PROOF_NO_STATISTICAL_CLAIM",
    "private_e2e": "BOUNDED_PRIVATE_RELIABILITY",
    "single_owner": "SINGLE_SOURCE_FUNCTIONAL_PROOF_ONLY",
    "beta": "RELEASE_RELIABILITY_ONLY",
    "rights_or_market_claim": "FORBIDDEN_FROM_SAMPLE_SIZE"
  }
  ,"promotion_matrix": {
    "CONTROL_ONLY_FUNCTIONAL": {"maximum_claim":"DETERMINISTIC_PLUMBING_ONLY","release_allowed":false},
    "CANARY": {"maximum_claim":"SCHEMA_BOUNDARY_SMOKE_ONLY","release_allowed":false},
    "ADAPTER_QUALIFICATION": {"maximum_claim":"SOURCE_PIPELINE_QUALIFIED","release_allowed":false},
    "BOUNDED_FUNCTIONAL_PILOT": {"maximum_claim":"BOUNDED_PRIVATE_FUNCTIONAL_PROOF_NO_STATISTICAL_CLAIM","release_allowed":false},
    "PRIVATE_E2E": {"maximum_claim":"BOUNDED_PRIVATE_RELIABILITY","release_allowed":false},
    "BETA_RELIABILITY": {"maximum_claim":"BOUNDED_BETA_RELIABILITY","release_allowed":false},
    "PRODUCTION_READINESS": {"required_tier":"BETA_RELIABILITY","required_natural_runs":30,"required_window_days":7,"requires_slo_error_budget":true,"requires_pitr_rollback_receipt":true,"release_allowed":false},
    "PRODUCTION": {"required_tier":"PRODUCTION_READINESS","release_allowed":true,"program_owner_approval_required":true}
  },
  "automatic_escalation": {
    "requested_claim_is_authoritative": true,
    "lower_tier_cannot_satisfy_higher_claim": true,
    "public_or_production_request_requires": "PRODUCTION",
    "policy_version_and_digest_sealed_before_observation": true,
    "threshold_downgrade_at_runtime": false
  }
}
