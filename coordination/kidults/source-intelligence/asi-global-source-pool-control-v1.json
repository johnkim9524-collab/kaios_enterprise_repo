    "CONDITIONAL": [
      "bounded purpose and claim ceiling explicit",
      "unresolved atoms cannot be inherited as permission"
    ],
    "HOLD": [
      "any rights atom unknown",
      "account/login/contract/spend required but unapproved",
      "schema or provenance incomplete"
    ],
    "NO_GO": [
      "collection prohibited",
      "required commercial reuse denied",
      "robots/terms conflict for intended method"
    ]
