        "CANONICAL_ENTITY_GRAPH",
        "EVIDENCE_AND_MARKET_EVENT_GRAPHS",
        "SOURCE_SEMANTIC_FINGERPRINTS",
        "NORMALIZATION_AND_RECONCILIATION_METHODS",
        "PROVIDER_SWITCHING_AND_REPLACEMENT_LAYER",
        "CONFIDENCE_AND_CALIBRATION",
        "DERIVED_INTELLIGENCE",
        "DECISION_FEEDBACK_AND_EVIDENCE_ECONOMICS"
