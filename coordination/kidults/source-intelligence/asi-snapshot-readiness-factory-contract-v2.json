    "p1_artifact": "kidults-asi-p1-source-preflight-v1",
    "p2_artifact": "kidults-asi-owned-source-intelligence-graph-v2",
    "p0b_required_files": [
      "p0b-source-candidate-registry-v1.json",
      "p0b-mission-candidate-binding-ledger-v1.json",
