    "p1_required_files": [
      "p1-gate1-source-safety-decisions-v1.json",
      "p1-evidence-admission-candidate-register-v1.json",
      "p1-preflight-action-queue-v1.json",
      "p1-source-preflight-manifest-v1.json"
    ],
    "p2_required_files": [
      "owned-source-intelligence-graph-v2.json",
      "owned-source-intelligence-lineage-v2.json",
      "owned-source-intelligence-quality-v2.json",
      "owned-source-intelligence-value-receipt-v2.json",
      "owned-source-intelligence-manifest-v2.json"
    ]
  },
  "readiness_dimensions": [
    "MISSION_SOURCE_CANDIDATE_COVERAGE",
    "PRIMARY_FALLBACK_REPLACEMENT_COVERAGE",
    "GATE1_SOURCE_SAFETY",
    "PURPOSE_SPECIFIC_RIGHTS",
    "MARKET_SEMANTIC_SUFFICIENCY",
    "FACTUAL_ORIGIN_INDEPENDENCE",
    "EVIDENCE_ADMISSION",
    "CURRENT_SOLD_TRANSACTION_EVIDENCE",
