    "SOURCE_COVERAGE_BIAS_ANALYSIS",
    "SOURCE_INDEPENDENCE_REDUNDANCY_ANALYSIS",
    "SOURCE_FRESHNESS_STABILITY_ANALYSIS",
    "SOURCE_COST_ROI_ANALYSIS"
