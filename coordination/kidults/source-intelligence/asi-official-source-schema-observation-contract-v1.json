  "transport": {
    "protocol": "HTTPS_ONLY",
    "default_port_only": true,
    "credentials_forbidden": true,
    "cookies_forbidden": true,
    "request_methods": ["GET"],
    "paths": ["/","/robots.txt"],
    "max_redirects": 3,
    "max_body_bytes": 65536,
    "connect_timeout_ms": 10000,
    "total_timeout_ms": 20000,
    "private_or_special_ip_forbidden": true,
    "pinned_dns_and_tls_hostname_verification_required": true,
    "user_agent": "KIDULTS-ASI-Schema-Observation/1.0 (+bounded-read-only)"
