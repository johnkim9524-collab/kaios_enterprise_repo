  "observation": {
    "persist_raw_body": false,
    "persist_body_digest": true,
    "persist_http_status": true,
    "persist_content_type": true,
    "persist_title": true,
    "persist_json_ld_types": true,
    "persist_terms_privacy_links": true,
    "persist_same_host_result_path_candidates": true,
    "follow_discovered_links": false,
    "result_path_keywords": ["result","results","auction","auctions","sale","sales","archive","past","sold"]
  },
  "success_model": {
    "per_profile_terminal_receipt_required": true,
    "partial_failure_preserved": true,
    "network_failure_is_not_empty_market_activity": true,
    "root_reachability_is_not_live_result_extraction": true,
    "robots_or_terms_is_not_rights_pass": true
