  "required_outputs": [
    "official-source-schema-observation-ledger-v1.json",
    "official-source-result-path-candidate-registry-v1.json",
    "official-source-transport-receipt-v1.json",
    "official-source-schema-observation-manifest-v1.json"
  ],
  "hard_boundaries": [
    "EXACT_ALLOWLIST_ONLY",
    "NO_CREDENTIALS_COOKIES_OR_WRITES",
    "NO_PRIVATE_SPECIAL_OR_MIXED_DNS",
    "NO_UNVALIDATED_REDIRECT",
    "NO_RAW_BODY_PERSISTENCE",
    "NO_DISCOVERED_LINK_FOLLOW",
    "REACHABILITY_IS_NOT_RIGHTS_OR_EVIDENCE",
    "NO_EVIDENCE_ADMISSION_MARKET_EVENT_OR_SNAPSHOT"
