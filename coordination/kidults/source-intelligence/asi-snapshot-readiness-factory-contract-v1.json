  "automatic_activation": {"main_push": true, "schedule": "7 * * * *", "upstream_workflow": "KIDULTS ASI Owned Source Intelligence Graph v2", "manual_dispatch_role": "RECOVERY_OR_EXPLICIT_REPLAY_ONLY"},
  "hard_boundaries": ["SOURCE_INTELLIGENCE_GRAPH_IS_NOT_MARKET_EVIDENCE_GRAPH", "SOURCE_CANDIDATE_COUNT_IS_NOT_EVIDENCE_COUNT", "PREFLIGHT_ACTION_QUEUE_IS_NOT_EXECUTED_PREFLIGHT", "PREFLIGHT_COMPLETE_IS_NOT_RIGHTS_PASS", "ADMISSION_READINESS_IS_NOT_ADMISSION", "BLOCKER_PACKAGE_IS_NOT_EVIDENCE_PACKAGE", "SNAPSHOT_NON_GENERATION_RECEIPT_IS_NOT_SNAPSHOT_CANDIDATE", "TRACK_B_WAITING_STATE_IS_NOT_ASSESSMENT", "NO_SNAPSHOT_FILE_WHEN_GATE_FAILS"],
  "truth_boundary": {"assesses_snapshot_readiness": true, "creates_blocker_package": true, "creates_admission_demand_package": true, "creates_snapshot_candidate_when_not_ready": false, "creates_evidence_package_when_not_ready": false, "starts_track_b_assessment_when_not_ready": false, "admits_evidence": false, "creates_market_event": false, "creates_market_claim": false, "public_release": "HOLD", "production": "HOLD"}
}
