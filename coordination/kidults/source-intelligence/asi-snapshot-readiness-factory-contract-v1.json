  "readiness_states": ["READY_FOR_IMMUTABLE_SNAPSHOT_GENERATION", "NOT_READY_NO_ADMITTED_EVIDENCE", "NOT_READY_RIGHTS_OR_SEMANTICS", "NOT_READY_MARKET_EVENT_GRAPH", "NOT_READY_IMMUTABLE_EVIDENCE_PACKAGE"],
