  "admission_demand_classes": ["RIGHTS_REVIEW_REQUIRED", "SEMANTIC_REFINEMENT_REQUIRED", "TECHNICAL_RECOVERY_REQUIRED", "ACCESS_OR_ROBOTS_REJECTED", "HOST_PREFLIGHT_REQUIRED", "SOURCE_DISCOVERY_EXPANSION_REQUIRED", "FACTUAL_ORIGIN_VERIFICATION_REQUIRED"],
  "required_outputs": ["snapshot-readiness-ledger-v1.json", "immutable-blocker-package-v1.json", "admission-demand-package-v1.json", "snapshot-non-generation-receipt-v1.json", "track-b-handoff-readiness-v1.json", "snapshot-readiness-manifest-v1.json"],
