{
  "id": "autonomous-source-intelligence-program-v1",
  "record_type": "source_intelligence_program_contract",
  "version": "1.0.0",
  "status": "ACTIVE_P0",
  "created_at": "2026-08-16T18:10:00+09:00",
  "created_by": "KPMO / Atlas",
  "approved_by": "John",
  "first_value": "AUTONOMOUS",
  "problem_statement": "The current low-volume authority-source PoCs validate ingestion, rights, provenance and graph mechanics, but they do not define the platform-wide data scope, map the global source universe, measure source utility and risk at scale, or provide a representative basis for market signals and customer trust.",
  "current_poc_reclassification": {
    "classification": "PHASE_0_ENGINEERING_AND_GOVERNANCE_POC",
    "market_signal_claim_authorized": false,
    "customer_trust_claim_authorized": false,
    "candidate_r2_authorized": false,
    "index_computation_authorized": false
  },
  "north_star": "Discover, classify, risk-score, select, collect and continuously reassess global collectible-market sources against a precisely versioned data scope before producing market signals.",
  "canonical_flow": [
    "Decision and Product Requirements",
    "Data Scope Registry",
    "Collection Scope Registry",
    "Global Source Universe Discovery",
    "Source Intelligence Graph",
    "Source Utility and Risk Scoring",
    "Coverage and Sampling Optimizer",
    "Rights-Aware Collection Orchestrator",
    "Raw Quarantine",
    "Entity Resolution",
    "Evidence Graph",
    "Market Graph",
    "Bias and Stability Tests",
    "Signal and Index Eligibility Gate",
    "Projection"
  ],
  "data_scope": {
    "required_layers": [
      "entity_scope",
      "event_scope",
      "signal_scope",
      "metric_scope",
      "geography_scope",
      "time_scope",
      "price_scope",
      "condition_and_grade_scope",
      "rights_and_provenance_scope",
      "inclusion_and_exclusion_rules"
    ],
    "entity_classes": [
      "SOURCE_RECORD",
      "PHYSICAL_OBJECT",
      "CANONICAL_DESIGN",
      "EDITION_OR_VARIANT",
      "MARKET_EVENT",
      "ACTOR",
      "VENUE",
      "EVIDENCE_ASSERTION"
    ],
    "event_classes": [
      "RELEASE",
      "LISTING",
      "SOLD_TRANSACTION",
      "AUCTION_RESULT",
      "PRIVATE_SALE",
      "GRADING",
      "AUTHENTICATION",
      "CONDITION_ASSESSMENT",
      "PROVENANCE_CHANGE",
      "EXHIBITION_OR_INSTITUTIONAL_RECOGNITION",
      "CULTURAL_ATTENTION_EVENT"
    ],
    "metric_families": [
      "IDENTITY_CONFIDENCE",
      "DEMAND",
      "SUPPLY",
      "LIQUIDITY",
      "PRICE_LEVEL",
      "PRICE_MOMENTUM",
      "VOLATILITY",
      "SCARCITY",
      "AUTHENTICATION_AND_CONDITION",
      "CULTURAL_ATTENTION",
      "INSTITUTIONAL_IMPORTANCE",
      "PROVENANCE_STRENGTH"
    ]
  },
  "source_roles": [
    "PRIMARY_MANUFACTURER_OR_CREATOR",
    "INSTITUTIONAL_AUTHORITY",
    "REFERENCE_CATALOG",
    "MARKETPLACE_LISTING",
    "SOLD_TRANSACTION",
    "AUCTION_OR_PRIVATE_SALE",
    "AUTHENTICATION_OR_GRADING",
    "PROVENANCE_OR_OWNERSHIP",
    "CULTURE_AND_ATTENTION",
    "MACRO_CONTEXT",
    "INDEPENDENT_CORROBORATION"
  ],
  "source_intelligence_engines": [
    {
      "engine": "DATA_SCOPE_COMPILER",
      "purpose": "Translate product and decision requirements into versioned entities, events, fields, metrics, inclusion rules and collection scopes."
    },
    {
      "engine": "SOURCE_UNIVERSE_DISCOVERY",
      "purpose": "Discover and deduplicate public, licensed and potential-provider channels across domains, APIs, datasets, marketplaces, auction houses, manufacturers, institutions, specialist databases and communities."
    },
    {
      "engine": "SOURCE_INTELLIGENCE_GRAPH",
      "purpose": "Model ownership, jurisdiction, source family, role, coverage, overlap, dependency, access mode and corroboration relationships."
    },
    {
      "engine": "SOURCE_UTILITY_SCORER",
      "purpose": "Score market relevance, coverage, uniqueness, granularity, freshness, verifiability, independence and expected signal contribution."
    },
    {
      "engine": "SOURCE_RISK_ENGINE",
      "purpose": "Identify and score rights, terms, robots, privacy, IP, commercial-use, rate-limit, security, fraud, manipulation, provenance, stability, bias, jurisdiction, cost and vendor-lock risks."
    },
    {
      "engine": "COVERAGE_AND_SAMPLING_OPTIMIZER",
      "purpose": "Select source mixes and stratified samples across collection scope, geography, time, price, condition, rarity and source family while minimizing blind spots and concentration."
    },
    {
      "engine": "COLLECTION_ORCHESTRATOR",
      "purpose": "Execute bounded, rights-aware, rate-limited, auditable and recoverable collection plans."
    },
    {
      "engine": "BIAS_DRIFT_AND_STABILITY_ENGINE",
      "purpose": "Measure source concentration, missingness, survivorship, geography, price-tier, platform, seller, temporal and algorithmic bias plus source-removal sensitivity and drift."
    }
  ],
  "active_execution_modules": [
    {
      "module_id": "asi-global-source-universe-v1",
      "contract": "coordination/kidults/source-intelligence/asi-global-source-universe-v1.json",
      "builder": "scripts/kidults/source-intelligence/build-asi-global-source-universe-v1.mjs",
      "validator": "scripts/kidults/source-intelligence/validate-asi-global-source-universe-v1.mjs",
      "candidate_compiler": "scripts/kidults/source-intelligence/compile-asi-global-open-market-candidates-v1.mjs",
      "candidate_compiler_validator": "scripts/kidults/source-intelligence/validate-asi-global-open-market-candidate-compiler-v1.mjs",
      "purpose": "Continuously enumerate and review the worldwide public open-market universe across 32 canonical Scopes, seven required Source roles and 12 regions without a numeric site-count completion target.",
      "market_first_roles": ["LISTING_SUPPLY", "SOLD_TRANSACTION", "AUTHENTICATION_CONDITION"],
      "discovery_authorizes_acquisition": false,
      "production": "HOLD"
    }
  ],
  "poc_scale_targets": {
    "source_candidates_discovery_mode": "CONTINUOUS_OPEN_ENDED_GLOBAL_OPEN_MARKET_ENUMERATION",
    "global_open_market_site_discovery_mode": "CONTINUOUS_OPEN_ENDED_NO_NUMERIC_SITE_TARGET",
    "sources_deep_risk_scored_minimum": 1000,
    "sources_terms_and_access_preflighted_minimum": 250,
    "shadow_source_adapters_minimum": 40,
    "raw_records_collected_minimum": 100000,
    "admitted_records_minimum": 50000,
    "independent_source_families_minimum": 20,
    "priority_collection_scopes_minimum": 12,
    "geographic_regions_minimum": 5,
    "public_images_ingested": 0,
    "production_mutations": 0
  },
  "readiness_gates": {
