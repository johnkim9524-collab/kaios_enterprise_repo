    "minimum_rights_and_provenance_coverage": 1.0,
    "minimum_sample_and_coverage_thresholds": "DEFINED_PER_COLLECTION_SCOPE_BEFORE_COLLECTION",
    "bias_and_concentration_report": "PASS_OR_EXPLICITLY_BOUNDED",
    "contradiction_test": "PASS",
    "source_removal_test": "PASS_OR_EXPLICITLY_BOUNDED",
    "confidence_classification_required": true,
    "unsupported_metric_state": "NOT_VERIFIED",
    "public_signal_authorized": false
  },
