    "field_level_rights_state_coverage": 1.0,
    "critical_provenance_coverage": 1.0,
    "unresolved_critical_source_risk": 0,
    "duplicate_contamination_maximum": 0.01,
    "stale_record_admission": 0,
    "rights_missing_admission": 0,
    "provider_id_promoted_to_canonical": 0,
