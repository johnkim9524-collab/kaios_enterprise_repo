{
  "id": "kidults-asi-legal-commercial-two-stage-verification-gate-v1",
  "version": "1.0.0",
  "status": "P0_FAIL_CLOSED_EXECUTION_CONTRACT",
  "production": "HOLD",
  "public_release": "HOLD",
  "purpose": "Require two sequential legal/commercial verification passes before a discovered source can become eligible for bounded automated acquisition, while allowing clearly open/public sources to proceed without unnecessary human approval and preserving explicit approval gates for externally binding actions.",
  "pipeline": [
    "DISCOVERY_METADATA_ONLY",
    "GATE_1_INITIAL_LEGAL_COMMERCIAL_VERIFICATION",
    "GATE_2_INDEPENDENT_LEGAL_COMMERCIAL_REVERIFICATION",
    "COLLECTION_ELIGIBILITY_ROUTER"
  ],
  "gate_1": {
    "name": "INITIAL_LEGAL_COMMERCIAL_VERIFICATION",
    "owner": "ASI_SOURCE_DISCOVERY_AND_PREFLIGHT",
    "input_state": "DISCOVERY_METADATA_ONLY",
    "required_checks": [
      "canonical_domain_or_locator",
      "source_owner_identity",
      "source_type_and_role",
      "region_country_language_context",
      "access_mode",
      "terms_state",
      "robots_or_machine_access_signal",
      "license_or_open_data_signal",
      "commercial_use_signal",
      "automated_access_signal",
      "login_paywall_member_area_signal",
      "api_feed_bulk_download_signal",
      "retention_signal",
      "derivation_signal",
      "redistribution_signal",
      "attribution_signal",
      "source_role_and_evidence_demand_binding",
      "observed_at",
      "source_material_refs"
    ],
    "decisions": [
      "PASS_TO_REVERIFICATION",
      "REVIEW_REQUIRED",
      "HARD_BLOCK"
    ],
    "pass_requirements": [
      "SOURCE_IDENTITY_ESTABLISHED",
      "NO_KNOWN_TERMS_CONFLICT_FOR_INTENDED_DISCOVERY_OR_COLLECTION_MODE",
      "NO_ROBOTS_OR_TECHNICAL_CIRCUMVENTION_REQUIRED",
      "NO_UNAUTHORIZED_LOGIN_OR_CREDENTIAL_SHARING_REQUIRED",
      "ACCESS_AND_LICENSE_SIGNALS_ARE_TRACEABLE",
      "PUBLIC_VISIBILITY_NOT_TREATED_AS_COMMERCIAL_USE_RIGHT",
      "MISSING_OR_AMBIGUOUS_REQUIRED_SIGNAL_DOES_NOT_PASS"
    ],
    "hard_block_triggers": [
      "ROBOTS_OR_TECHNICAL_CIRCUMVENTION_REQUIRED",
      "CREDENTIAL_SHARING_OR_UNAUTHORIZED_LOGIN_REQUIRED",
      "TERMS_EXPLICITLY_PROHIBIT_INTENDED_USE",
      "KNOWN_UNLAWFUL_OR_UNAUTHORIZED_SOURCE",
      "MALICIOUS_OR_DECEPTIVE_SOURCE_IDENTITY"
    ],
    "output": "GATE_1_RECEIPT",
    "output_to_gate_2_only": true
  },
  "gate_2": {
    "name": "INDEPENDENT_LEGAL_COMMERCIAL_REVERIFICATION",
    "owner": "RIGHTS_AND_COMMERCIAL_REVERIFICATION_CONTROL",
    "predecessor": "GATE_1_INITIAL_LEGAL_COMMERCIAL_VERIFICATION",
    "independence_rules": [
      "DO_NOT_COPY_GATE_1_DECISION_AS_EVIDENCE",
      "REOPEN_CURRENT_PRIMARY_TERMS_LICENSE_OR_OFFICIAL_POLICY_REFERENCE_WHERE_AVAILABLE",
      "RECHECK_CURRENTNESS_AND_EXPIRY",
      "RECHECK_SOURCE_OWNER_AND_DOMAIN_BINDING",
      "RECHECK_PURPOSE_BY_PURPOSE_RIGHTS",
      "RECHECK_COMMERCIAL_OBLIGATIONS",
      "RECHECK_ACCESS_MODE_AND_MACHINE_ACCESS_COMPATIBILITY"
    ],
    "required_purposes": [
      "discover_metadata",
      "collect",
      "store",
      "derive",
      "internal_calibration",
      "retention",
      "redistribute",
      "public_project",
      "sold_event_fields",
      "listing_fields",
      "population_or_census_fields"
    ],
    "required_commercial_dimensions": [
      "account_or_membership_required",
      "eula_or_contract_required",
      "paid_plan_or_spend_required",
      "credential_required",
      "rate_or_volume_limits",
      "data_retention_constraints",
      "derived_output_constraints",
      "redistribution_constraints",
      "attribution_or_notice_duties",
      "termination_or_deletion_duties"
    ],
    "decisions": [
      "VERIFIED_AUTO_COLLECT_ELIGIBLE",
      "VERIFIED_CONDITIONAL_APPROVAL_REQUIRED",
      "NEEDS_CLARIFICATION",
      "BLOCKED"
    ],
    "auto_collect_rule": "EVERY_ACTUAL_COLLECTION_PURPOSE_AND_REQUIRED_COMMERCIAL_DIMENSION_IS CURRENTLY AND SOURCE_SPECIFICALLY SUPPORTED, WITH NO NEW CONTRACT_EULA_SPEND_CREDENTIAL_OR_EXTERNAL_COMMITMENT REQUIRED",
    "conditional_rule": "RIGHTS_MAY_BE COMPATIBLE BUT A NEW CONTRACT_EULA_SPEND_CREDENTIAL_PERMISSION_OR_OTHER EXTERNALLY BINDING APPROVAL IS REQUIRED",
    "no_inference_rules": [
      "PUBLIC_VISIBILITY_IS_NOT_COMMERCIAL_USE_RIGHT",
      "API_ACCESS_IS_NOT_STORAGE_RIGHT",
      "LISTING_ACCESS_IS_NOT_SOLD_EVENT_RIGHT",
      "ACCOUNT_ACCESS_IS_NOT_DERIVATION_RIGHT",
      "HISTORICAL_PERMISSION_IS_NOT_CURRENT_PERMISSION",
      "GATE_1_PASS_IS_NOT_GATE_2_PASS"
    ],
    "output": "GATE_2_REVERIFICATION_RECEIPT"
  },
  "collection_eligibility_router": {
    "auto_route": {
      "when": "GATE_2_DECISION_IS_VERIFIED_AUTO_COLLECT_ELIGIBLE",
      "state": "ELIGIBLE_FOR_BOUNDED_AUTOMATED_ACQUISITION",
      "human_approval_required": false
    },
    "approval_route": {
      "when": "GATE_2_DECISION_IS_VERIFIED_CONDITIONAL_APPROVAL_REQUIRED",
      "state": "EXTERNAL_APPROVAL_REQUIRED",
      "human_approval_required": true,
      "approval_reasons": [
        "NEW_EULA_OR_CONTRACT",
        "PAID_PLAN_OR_SPEND",
        "NEW_OR_EXPANDED_CREDENTIAL_PERMISSION",
        "PROVIDER_ACTIVATION_WITH_EXTERNAL_COMMITMENT",
        "AMBIGUOUS_OR_CUSTOM_LICENSE",
        "PUBLIC_INTELLIGENCE_AUTHORIZATION",
        "PRODUCTION_OR_G5"
      ]
    },
    "blocked_route": {
      "when": "GATE_2_DECISION_IS_BLOCKED_OR_NEEDS_CLARIFICATION",
      "state": "NO_COLLECTION"
    }
  },
  "required_candidate_risk_fields": [
    "legal_risk_tier",
    "commercial_risk_tier",
    "rights_clarity",
    "terms_state",
    "robots_state",
    "access_mode",
    "license_type",
    "commercial_use_signal",
    "automated_access_signal",
    "login_or_paywall",
    "api_or_feed_availability",
    "retention_signal",
    "derivation_signal",
    "redistribution_signal",
    "attribution_signal",
    "gate_1_decision",
    "gate_1_verified_at",
    "gate_1_evidence_refs",
    "gate_2_decision",
    "gate_2_reverified_at",
    "gate_2_evidence_refs",
    "next_revalidation_at"
  ],
  "state_transition_rules": [
    "DISCOVERY_CANNOT_SKIP_GATE_1",
    "GATE_1_CANNOT_SKIP_GATE_2",
    "GATE_2_MUST_REVERIFY_INDEPENDENTLY",
    "GATE_1_PASS_DOES_NOT_CREATE_COLLECTION_RIGHT",
    "ONLY_GATE_2_VERIFIED_AUTO_COLLECT_ELIGIBLE_CAN_AUTO_ROUTE_TO_BOUNDED_COLLECTION",
    "EXTERNALLY_BINDING_ACTION_REQUIRES_EXPLICIT_APPROVAL",
    "UNKNOWN_OR_MISSING_REQUIRED_FIELD_FAILS_CLOSED",
    "RIGHTS_EXPIRY_OR_SCOPE_CHANGE_FORCES_GATE_2_REVERIFICATION",
    "BLOCKED_OR_REVOKED_SOURCE_CANNOT_REENTER_WITH_NEW_RECORD_ID_WITHOUT_NEW_AUTHORITY",
    "NO_GATE_CREATES_EMPIRICAL_EVIDENCE_MARKET_TRUTH_PUBLIC_RELEASE_OR_PRODUCTION_AUTHORITY"
  ],
  "truth_boundary": "Gate 1 is initial legal/commercial verification. Gate 2 independently re-verifies the current primary evidence and purpose-specific rights. Only a Gate 2 VERIFIED_AUTO_COLLECT_ELIGIBLE result may enter bounded automated acquisition without human approval; externally binding actions remain approval-gated."
}
