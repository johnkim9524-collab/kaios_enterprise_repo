      "UNREPRESENTED_AUTHORITY_SURFACES",
      "UNREPRESENTED_TRUST_SURFACES",
      "REGIONAL_AND_LANGUAGE_GAPS",
      "SOURCE_CONCENTRATION_AND_OWNER_FAMILY_GAPS"
    ]
  },
  "candidate_record_minimum": [
