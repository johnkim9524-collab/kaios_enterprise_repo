    "discovery_is_not_collection": true,
    "collection_is_not_admission": true,
    "admission_is_not_claim": true
  },
  "source_layers": [
    {
      "layer": "L0_AUTHORITY",
      "purpose": "Official legal, regulatory, registry and institutional facts.",
      "maps_to_existing_roles": ["PRIMARY_AUTHORITY", "INDEPENDENT_VERIFICATION"],
      "candidate_entity_types": ["GOVERNMENT", "REGULATOR", "OFFICIAL_REGISTRY", "STANDARDS_BODY", "INSTITUTION"]
    },
    {
      "layer": "L1_ORIGIN",
      "purpose": "Canonical product and object origin, release, specification and lifecycle facts.",
      "maps_to_existing_roles": ["PRIMARY_AUTHORITY", "CATALOG_REFERENCE"],
      "candidate_entity_types": ["MANUFACTURER", "BRAND", "PUBLISHER", "MINT", "STUDIO", "IP_OWNER", "LICENSEE", "ARTIST_ATELIER"]
    },
    {
      "layer": "L2_DISTRIBUTION",
      "purpose": "Primary distribution, regional availability, inventory and channel facts.",
      "maps_to_existing_roles": ["CATALOG_REFERENCE", "LISTING_SUPPLY"],
      "candidate_entity_types": ["OFFICIAL_DISTRIBUTOR", "AUTHORIZED_RETAILER", "DEALER", "PRIMARY_MARKET"]
    },
    {
      "layer": "L3_MARKET",
      "purpose": "Listings, sold transactions, auctions, private-sale evidence and liquidity observations.",
      "maps_to_existing_roles": ["LISTING_SUPPLY", "SOLD_TRANSACTION", "AUCTION_PRIVATE_SALE"],
      "candidate_entity_types": ["MARKETPLACE", "AUCTION_HOUSE", "EXCHANGE", "DEALER_MARKET", "PRIVATE_SALE_VENUE"]
    },
    {
      "layer": "L4_TRUST",
      "purpose": "Authentication, grading, certification, population and provenance evidence.",
      "maps_to_existing_roles": ["AUTHENTICATION_CONDITION", "PROVENANCE_HISTORY", "INDEPENDENT_VERIFICATION"],
      "candidate_entity_types": ["GRADING_AUTHORITY", "AUTHENTICATOR", "CERTIFICATION_REGISTRY", "POPULATION_CENSUS", "PROVENANCE_REGISTRY"]
    },
    {
      "layer": "L5_INTELLIGENCE",
      "purpose": "Context, research, specialist databases, cultural attention and independent interpretation.",
      "maps_to_existing_roles": ["CULTURE_ATTENTION", "MACRO_CONTEXT", "INDEPENDENT_VERIFICATION"],
      "candidate_entity_types": ["SPECIALIST_DATABASE", "RESEARCH_SOURCE", "TRADE_MEDIA", "COMMUNITY_CONTEXT", "ARCHIVE"]
    }
  ],
  "origin_discovery_policy": {
    "manufacturer_search_required": true,
    "manufacturer_is_not_sufficient": true,
    "expand_to": ["BRAND", "PUBLISHER", "MINT", "STUDIO", "IP_OWNER", "LICENSEE", "OFFICIAL_DISTRIBUTOR"],
    "canonical_anchor_preference": "OFFICIAL_OR_FACTUAL_ORIGIN_WHERE_LAWFUL_AND_TRACEABLE",
    "marketplace_may_define_value_observation_but_not_canonical_product_identity": true,
    "preserve_local_language_and_regional_semantics": true
  },
  "coverage_cube": {
