    "coordination/kidults/source-intelligence/global-source-mesh-contract-v1.json",
    "coordination/kidults/source-intelligence/autonomous-source-intelligence-program-v1.json"
  ],
  "non_conflict_boundary": {
    "classification": "SEPARATE_PROGRAM",
    "main_mutation": false,
    "runtime_mutation": false,
    "workflow_mutation": false,
    "aws_mutation": false,
    "staging_mutation": false,
    "provider_call": false,
    "provider_activation": false,
    "credential_change": false,
    "external_spend": false,
    "production": "HOLD",
    "public_release": "HOLD",
    "g5": "HOLD",
    "autonomous_normal_operations_closure_files": "DO_NOT_TOUCH",
    "psa_validation_files_and_receipts": "DO_NOT_TOUCH",
