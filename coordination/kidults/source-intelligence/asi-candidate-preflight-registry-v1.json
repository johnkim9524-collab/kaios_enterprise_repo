{
  "id": "kidults-asi-candidate-preflight-registry-v1",
  "version": "1.0.0",
  "status": "ACTIVE_AFTER_MAIN_MERGE",
  "owner": "KPMO",
  "priority": "P1",
  "platform_principles": [
    "AUTONOMOUS",
    "GLOBAL",
    "IRREPLACEABLE_VALUE",
    "TRANSPARENT"
  ],
  "registered_assets": {
    "contract": "coordination/kidults/source-intelligence/asi-candidate-preflight-contract-v1.json",
    "mission_consumption_contract": "coordination/kidults/source-intelligence/asi-mission-consumption-contract-v1.json",
    "runner": "scripts/kidults/source-intelligence/run-asi-candidate-preflight-wave-v1.mjs",
    "validator": "scripts/kidults/source-intelligence/validate-asi-candidate-preflight-wave-v1.mjs",
    "workflow": ".github/workflows/kidults-asi-candidate-preflight-wave-v1.yml",
    "human_readme": "docs/kidults/asi/asi-candidate-preflight-wave-v1.md"
  },
  "registered_outputs": [
    "candidate-host-preflight-ledger-v1.json",
    "candidate-preflight-assignment-v1.json",
    "candidate-admission-readiness-v1.json",
    "candidate-preflight-health-v1.json",
    "candidate-preflight-manifest-v1.json"
  ],
  "automatic_activation": {
    "main_push": true,
    "schedule": "37 * * * *",
    "upstream_workflow": "KIDULTS ASI Mission Consumption Wave v1",
    "manual_dispatch_role": "RECOVERY_OR_EXPLICIT_REPLAY_ONLY"
  },
  "rolling_execution": {
    "unit": "UNIQUE_CANONICAL_HOST",
    "maximum_hosts_per_cycle": 96,
    "restore_previous_ledger": true,
    "skip_preflighted_hosts": true,
    "new_candidates_enter_next_cycle": true,
    "all_candidates_receive_completed_or_waiting_assignment": true
  },
  "execution_guarantees": {
    "bounded_root_and_robots_only": true,
    "maximum_body_bytes": 65536,
    "discovered_links_followed": false,
    "market_records_collected": false,
    "robots_allow_is_license": false,
    "automatic_rights_pass": false,
    "rights_unknown_is_explicit": true,
    "network_and_access_failures_are_explicit": true,
    "no_direct_repository_mutation_from_workflow": true
  },
  "truth_boundary": {
    "preflight_is_admission": false,
    "reachable_is_lawful_to_collect": false,
    "robots_allow_is_license": false,
    "terms_link_is_rights_pass": false,
    "semantic_signal_is_evidence": false,
    "external_market_record_collection_executed": false,
    "collection_right_created": false,
    "evidence_admitted": false,
    "market_claim_created": false,
    "public_release": "HOLD",
    "production": "HOLD"
  }
}
