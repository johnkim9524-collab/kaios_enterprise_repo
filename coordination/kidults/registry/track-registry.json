{
  "schema_version": "1.4.0",
  "status": "ACTIVE",
  "tracks": [
    {
      "track_id": "A",
      "name": "120 Intelligence Factory",
      "mission": "Create reproducible Snapshot Candidates from Right Data with measured speed, quality, scale and recovery.",
      "may": ["CREATE_CANDIDATE", "RUN_POC_EXPERIMENTS"],
      "must_not": ["DIRECT_PORTAL_DEPLOY", "PRODUCTION_APPROVAL", "ABSOLUTE_SUPERIORITY_CLAIM", "OVERWRITE_BASELINE", "MISSING_TO_ZERO"]
    },
    {
      "track_id": "B",
      "name": "Rankability & Validation Gate",
      "authority_model": "INDEPENDENT_VALIDATION_AUTHORITY",
      "operating_rules_status": "FINAL_LOCKED_V1_3",
      "mission": "Receive one registered Track A Snapshot Candidate, validate its Evidence Package, generate one immutable rankability-assessment.json, and hand it to the Integration Gate.",
      "official_inputs": ["snapshot-candidate.json", "EVIDENCE_PACKAGE"],
      "official_output": "rankability-assessment.json",
      "input_boundary": {
        "both_official_inputs_required_before_assessment": true,
        "non_official_inputs": [
          "PORTAL_RESULT",
          "BUSINESS_REQUEST",
          "PROVIDER_REQUIREMENT",
          "ESTIMATE",
          "VERBAL_EXPLANATION",
          "CHAT_ONLY_INFORMATION"
        ]
      },
      "output_boundary": {
        "only_official_output": "rankability-assessment.json",
        "must_not_generate": [
          "snapshot-candidate.json",
          "PORTAL_RELEASE",
          "REGISTRY_CHANGE",
          "PRODUCTION_DECISION",
          "BUSINESS_RECOMMENDATION",
          "FINAL_RANKING"
        ]
      },
      "snapshot_scope": "EXACTLY_ONE_EXISTING_SNAPSHOT_ID",
      "snapshot_isolation": {
        "one_snapshot_per_assessment": true,
        "combined_snapshot_assessment_allowed": false,
        "historical_current_merge_allowed": false,
        "required_sequence": ["ONE_SNAPSHOT", "ONE_ASSESSMENT", "ONE_RECOMMENDATION"]
      },
      "assessment_policy": {
        "creates_snapshot": false,
        "creates_registry": false,
        "creates_portal_release": false,
        "creates_production_decision": false,
        "creates_business_decision": false,
        "creates_new_evidence": false,
        "evaluates_track_a_evidence_only": true,
        "required_sequence": ["SNAPSHOT", "EVIDENCE", "ASSESSMENT"],
        "insufficient_evidence_dispositions": ["NOT_RANKABLE", "BLOCKED"],
        "immutable_after_issue": true,
        "revision_model": "NEW_ASSESSMENT_NEW_ID_ARCHIVE_PRIOR",
        "assessment_id_example": ["assessment-r001", "assessment-r002", "assessment-r003"],
        "reproducibility": {
          "same_snapshot_and_same_evidence_must_produce_same_assessment": true,
          "different_result_requires_recorded_cause": true
        },
        "required_traceability_fields": [
          "assessment_id",
          "snapshot_id",
          "assessment_version",
          "registry_version",
          "methodology_version",
          "evidence_lineage_version",
          "generated_at",
          "assessment_status"
        ]
      },
      "assessment_completion": {
        "complete_requires_all": [
          "SNAPSHOT_ID_VERIFIED",
          "EVIDENCE_PACKAGE_VERIFIED",
          "ASSESSMENT_CONTRACT_VALIDATION_PASSED",
          "REGISTRY_TRACEABILITY_COMPLETED"
        ],
        "when_all_true": "COMPLETE",
        "otherwise": "INCOMPLETE"
      },
      "official_waiting_states": [
        "WAITING_FOR_SNAPSHOT",
        "WAITING_FOR_EVIDENCE",
        "WAITING_FOR_REGISTRY",
        "WAITING_FOR_VALIDATION"
      ],
      "temporary_or_estimated_assessment_allowed": false,
      "recommendation_policy": {
        "allowed": ["BLOCKED", "CONDITIONAL", "PUBLISHABLE"],
        "must_include_confidence": true,
        "confidence_levels": ["LOW", "MEDIUM", "HIGH"],
        "confidence_requires_assessment_evidence": true,
        "must_include_quantitative_justification": true,
        "quantitative_justification_fields": ["metric", "observed_value", "required_threshold", "comparison_result", "evidence_reference"],
        "opinion_only_recommendation_allowed": false,
        "may_specify": ["REQUIRED_EVIDENCE", "EXIT_CRITERIA", "ADDITIONAL_VALIDATION"]
      },
      "independence_preservation": {
        "decision_basis": ["SNAPSHOT", "EVIDENCE", "ASSESSMENT"],
        "must_ignore": ["TRACK_A_SPEED", "PORTAL_SCHEDULE", "PROVIDER_CONTRACT_SCHEDULE", "BUSINESS_PRIORITY", "PRODUCTION_SCHEDULE"]
      },
      "assessment_trigger": {
        "required_conditions": [
          "SNAPSHOT_ID_EXISTS",
          "SNAPSHOT_REGISTRY_REGISTRATION_COMPLETED",
          "SNAPSHOT_CANDIDATE_AVAILABLE",
          "EVIDENCE_PACKAGE_AVAILABLE",
          "REGISTRY_VALIDATION_PASSED"
        ],
        "when_all_true": "GENERATE_RANKABILITY_ASSESSMENT",
        "waiting_state_resolution": {
          "snapshot_missing": "WAITING_FOR_SNAPSHOT",
          "evidence_missing": "WAITING_FOR_EVIDENCE",
          "registry_registration_missing": "WAITING_FOR_REGISTRY",
          "registry_or_contract_validation_pending": "WAITING_FOR_VALIDATION"
        }
      },
      "archive_policy": {
        "delete_assessment_allowed": false,
        "modify_issued_assessment_allowed": false,
        "new_assessment_required_for_changed_evaluation": true,
        "prior_assessment_destination": "ASSESSMENT_ARCHIVE_REGISTRY"
      },
      "registry_access": {
        "mode": "READ_ONLY",
        "may_request_assessment_registration": true,
        "assessment_registration_owner": "ATLAS_KPMO",
        "governance_owner": "ATLAS_KPMO"
      },
      "may": [
        "INDEPENDENT_ASSESSMENT",
        "GENERATE_RANKABILITY_ASSESSMENT",
        "RECOMMEND_BLOCKED",
        "RECOMMEND_CONDITIONAL",
        "RECOMMEND_PUBLISHABLE",
        "SPECIFY_REQUIRED_EVIDENCE",
        "DEFINE_EXIT_CRITERIA",
        "REQUEST_ADDITIONAL_VALIDATION",
        "REQUEST_ASSESSMENT_REGISTRATION"
      ],
      "must_not": [
        "CREATE_REGISTRY",
        "GOVERN_REGISTRY",
        "MODIFY_REGISTRY",
        "CREATE_SNAPSHOT",
        "COMBINE_SNAPSHOTS",
        "MERGE_HISTORICAL_AND_CURRENT_SNAPSHOTS",
        "MODIFY_ISSUED_ASSESSMENT",
        "DELETE_ASSESSMENT",
        "MODIFY_SOURCE_OR_120_METRIC",
        "CREATE_NEW_EVIDENCE",
        "MODIFY_PORTAL",
        "CREATE_PORTAL_RELEASE",
        "DESIGN_OPERATING_SYSTEM",
        "SELECT_PORTAL_VISUAL",
        "RECOMMEND_FINAL_RANKING",
        "DECLARE_FINAL_TRUTH",
        "PROVIDER_CONTRACT",
        "PRODUCTION_APPROVAL",
        "PRODUCTION_RELEASE",
        "PORTAL_DESIGN",
        "BUSINESS_DECISION",
        "ISSUE_OPINION_ONLY_RECOMMENDATION",
        "USE_NON_OFFICIAL_INPUT_AS_ASSESSMENT_INPUT",
        "CREATE_TEMPORARY_ASSESSMENT",
        "CREATE_ESTIMATED_ASSESSMENT"
      ],
      "directive": {
        "name": "Track B Additional Operating Directive",
        "version": "v1.3",
        "status": "APPROVED",
        "rule_status": "FINAL_LOCKED",
        "effective": "IMMEDIATELY",
        "prior_version": "v1.2",
        "future_operating_rule_expansion_allowed": false,
        "next_official_work": "RECEIVE_SNAPSHOT_VALIDATE_EVIDENCE_GENERATE_ASSESSMENT_HANDOFF_TO_INTEGRATION_GATE"
      }
    },
    {
      "track_id": "C",
      "name": "Portal V502 & Experience Layer",
      "mission": "Render only approved Published Intelligence and production-ready assets through the Snapshot Contract.",
      "may": ["RENDER_UX", "REPORT_CONTRACT_ERROR"],
      "must_not": ["CALCULATE_RANKING", "CALCULATE_FEATURED", "ACCESS_RAW_PROVIDER_DATA", "MISSING_TO_ZERO", "PUBLISH_UNAPPROVED_ASSET"]
    }
  ]
}
