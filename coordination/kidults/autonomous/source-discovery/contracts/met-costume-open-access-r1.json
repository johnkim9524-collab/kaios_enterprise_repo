  "query": "dress",
  "bounded_limits": {
    "normalized_record_target": 12,
    "minimum_successful_records": 8,
    "maximum_object_requests": 50,
    "maximum_requests_per_second": 4,
    "retry_attempts": 3,
    "request_timeout_ms": 15000
  },
  "required_outputs": [
    "run-manifest.json",
    "sanitized-raw-records.json",
    "normalized-evidence-records.json",
    "evidence-package.json",
    "quality-report.json"
  ],
  "autonomous_controls": [
    "official-host allowlist",
    "bounded request budget",
    "timeout",
    "retry with backoff",
    "metadata sanitization",
    "raw payload hashing",
    "deduplication",
    "critical-field completeness",
    "provenance reference",
    "fail-closed minimum record gate"
  ],
  "prohibited_operations": [
    "credential use",
    "image download",
    "paid access",
    "provider mutation",
    "Portal publication",
    "Candidate publication",
    "Production mutation"
  ],
  "production_eligible": false,
  "references": [
    "https://metmuseum.github.io/",
