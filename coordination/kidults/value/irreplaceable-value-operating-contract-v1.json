  "north_star": "IRREPLACEABLE_CUSTOMER_AND_INSTITUTIONAL_DECISION_ADVANTAGE",
  "definition": "Irreplaceable Value is an explainable, evidence-backed and continuously improving decision advantage that cannot be reproduced at equivalent quality by any single Provider API, marketplace, public website, static database or generic AI model.",
  "canonical_value_equation": [
    "HIGH_VALUE_CUSTOMER_DECISION",
    "MULTI_SOURCE_INDEPENDENT_EVIDENCE",
    "CANONICAL_IDENTITY",
    "GLOBAL_AND_REPRESENTATIVE_COVERAGE",
    "BITEMPORAL_MEMORY_AND_CHANGE",
    "RISK_CONFIDENCE_AND_LIMITATIONS",
    "EXPLAINABLE_RECOMMENDATION",
    "AUTONOMOUS_CONTINUOUS_IMPROVEMENT",
    "RESILIENCE_TO_PROVIDER_REMOVAL"
  ],
  "mandatory_irreplaceability_tests": [
    {
      "test_id": "SINGLE_SOURCE_SUBSTITUTION_TEST",
      "pass_when": "No single Source can reproduce the output with equivalent identity, breadth, time depth, confidence and explanation."
    },
    {
      "test_id": "SINGLE_PROVIDER_SUBSTITUTION_TEST",
      "pass_when": "Removal of any one Provider reduces coverage or latency but does not destroy the platform truth or decision logic."
    },
    {
      "test_id": "GENERIC_AI_SUBSTITUTION_TEST",
      "pass_when": "A generic model without the governed Evidence Graph, Market Graph, Memory, rights lineage and Source contribution ledger cannot reproduce the output."
    },
    {
      "test_id": "DECISION_IMPACT_TEST",
      "pass_when": "The output changes, confirms, delays or rejects a real collector, institution, enterprise or Founder decision."
    },
    {
      "test_id": "EXPLAINABILITY_TEST",
      "pass_when": "The platform can show why the conclusion exists, which Evidence supports it, what conflicts remain and what is not verified."
    },
    {
      "test_id": "SOURCE_REMOVAL_RESILIENCE_TEST",
      "pass_when": "Critical conclusions remain available or fail closed with an explicit dependency report when a Source family is removed."
    }
  ],
