{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kidults-autonomous-intelligence",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kidults-intelligence-db",
      "database_id": "d6d65f81-f91d-428b-bf43-8a025aaa47bd",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "KIDULTS_ENV": "staging",
    "METHODOLOGY_VERSION": "v2.0-autonomous-foundation",
    "MIN_EVIDENCE_FOR_PUBLISH": "20",
    "SOURCE_ADAPTERS_JSON": "[{\"id\":\"staging-transactions-golden-path\",\"family\":\"marketplace\",\"endpoint\":\"https://kidults-autonomous-intelligence.john-kim9524.workers.dev/internal/golden-path/transactions\",\"enabled\":true,\"timeoutMs\":15000}]"
  }
}
