{
  "name": "@kaios/kidults-autonomous-intelligence",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "npm run deploy:preflight && wrangler deploy",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "runtime:smoke": "node scripts/runtime-smoke.mjs",
    "validate": "npm run typecheck && npm run runtime:smoke",
    "remote:d1:preflight": "node scripts/remote-d1-preflight.mjs",
    "a9:finalize": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/a9-finalize.ps1",
    "scale:smoke": "node scripts/a10-scale-certify.mjs --profile=smoke",
    "scale:100k": "node scripts/a10-scale-certify.mjs --profile=baseline",
    "scale:1m": "node scripts/a10-scale-certify.mjs --profile=million",
    "a10:certify": "npm run typecheck && npm run scale:smoke && npm run scale:100k",
    "persist:smoke": "node scripts/a11-persistence-certify.mjs --profile=smoke",
    "persist:100k": "node scripts/a11-persistence-certify.mjs --profile=baseline",
    "persist:1m": "node scripts/a11-persistence-certify.mjs --profile=million",
    "a11:certify": "npm run typecheck && npm run persist:smoke && npm run persist:100k && npm run persist:1m",
    "a12:5m": "node scripts/a12-scale-certify.mjs --profile=sustained5m",
    "a12:10m": "node scripts/a12-scale-certify.mjs --profile=partition10m",
    "a12:certify": "npm run typecheck && npm run a12:5m && npm run a12:10m",
    "a13:smoke": "node scripts/a13-provider-concurrency-certify.mjs --profile=smoke",
    "a13:baseline": "node scripts/a13-provider-concurrency-certify.mjs --profile=baseline",
    "a13:certify": "npm run typecheck && npm run a13:smoke && npm run a13:baseline",
    "a14:canary": "node scripts/a14-remote-capacity-canary.mjs",
    "a14:certify": "npm run typecheck && npm run remote:d1:preflight && npm run a14:canary",
    "a14:finalize": "npm run a14:certify && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-finalize.ps1 -Stage A14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260808.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.28.1"
  }
}
