{
  "name": "@kaios/kidults-autonomous-intelligence",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "npm run deploy:preflight && wrangler deploy",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "runtime:smoke": "node scripts/runtime-smoke.mjs",
    "validate": "npm run typecheck && npm run runtime:smoke",
    "a9:finalize": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/a9-finalize.ps1",
    "scale:smoke": "node scripts/a10-scale-certify.mjs --profile=smoke",
    "scale:100k": "node scripts/a10-scale-certify.mjs --profile=baseline",
    "scale:1m": "node scripts/a10-scale-certify.mjs --profile=million",
    "a10:certify": "npm run typecheck && npm run scale:smoke && npm run scale:100k"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260808.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.28.1"
  }
}
