{
  "stage": "A24",
  "mode": "fail-closed-production-readiness-evaluator",
  "policyVersion": "a24-production-activation-policy.v2",
  "description": "Canonical technical Production-readiness diagnostic. A24 performs no Production mutation or authorization; Production authority remains hard-disabled until a signed, archive-verified authority consumer exists.",
  "activationScope": "production-readiness-decision-only",
  "defaultDecision": "DENIED",
  "production_authority_hard_disabled_pending_signed_archive_consumer": true,
  "technical_readiness_is_not_production_authority": true,
  "lifecycle": [
    "observe",
    "decide",
    "policy",
    "preflight",
    "execute",
    "verify",
    "evidence",
    "activate",
    "monitor",
    "rollback-or-fail-closed"
  ],
  "activationClasses": {
    "DENIED": {
      "description": "Default class. No production activation permitted.",
      "mutationPermitted": false,
      "canaryPermitted": false,
      "publicationPermitted": false,
      "commercialPermitted": false
    },
    "INTERNAL_READY": {
      "description": "Target is certified for internal non-production use only. No production mutation.",
      "mutationPermitted": false,
      "canaryPermitted": false,
      "publicationPermitted": false,
      "commercialPermitted": false
    },
    "CANARY_READY": {
      "description": "Legacy class retained for historical report parsing only; it grants no A24 or Production execution authority.",
      "mutationPermitted": false,
      "canaryPermitted": false,
      "publicationPermitted": false,
      "commercialPermitted": false,
      "boundaryRequired": true,
      "rollbackRequired": true
    },
    "BOUNDED_PRODUCTION_READY": {
      "description": "Legacy class retained for historical report parsing only; it grants no A24 or Production execution authority.",
      "mutationPermitted": false,
      "canaryPermitted": false,
      "publicationPermitted": false,
      "commercialPermitted": false,
      "boundaryRequired": true,
      "rollbackRequired": true,
      "evidenceRequired": true,
      "verificationRequired": true
    },
    "PRODUCTION_READY": {
      "description": "Reserved future class. Technical readiness alone cannot emit this class while signed archive-verified Production authority consumption is absent.",
      "mutationPermitted": false,
      "canaryPermitted": false,
      "publicationPermitted": false,
      "commercialPermitted": false,
      "boundaryRequired": true,
      "rollbackRequired": true,
      "evidenceRequired": true,
      "verificationRequired": true,
      "separateProtectedExecutionRequired": true
    },
    "PUBLICATION_BLOCKED": {
      "description": "Target must not be publicly released. Blocked by A22 publication gate.",
      "mutationPermitted": false,
      "canaryPermitted": false,
      "publicationPermitted": false,
      "commercialPermitted": false
    },
    "COMMERCIAL_BLOCKED": {
      "description": "Target must not be used in monetized delivery. Blocked by A23 commercial gate.",
      "mutationPermitted": false,
      "canaryPermitted": false,
      "publicationPermitted": false,
      "commercialPermitted": false
    },
    "PROVIDER_BLOCKED": {
      "description": "Target requires validated provider evidence that is not yet present.",
      "mutationPermitted": false,
      "canaryPermitted": false,
      "publicationPermitted": false,
      "commercialPermitted": false
    },
    "ROLLBACK_ONLY": {
      "description": "Only rollback operations are permitted. No new production mutation.",
      "mutationPermitted": false,
      "canaryPermitted": false,
      "publicationPermitted": false,
      "commercialPermitted": false,
      "rollbackPermitted": true
    }
  },
  "allowedTargets": [
    "entity-master",
    "canon-strength",
    "market-momentum",
    "collector-sentiment",
    "price-index",
    "comparables",
    "scarcity-signal",
    "availability-monitor",
    "culture-velocity",
    "trend-radar",
    "auction-intelligence",
    "liquidity-signal",
    "provenance-confidence",
    "asset-history",
    "condition-risk",
    "auth-confidence",
    "category-outlook",
    "kidult-100"
  ],
  "prohibitedTargets": [
    "__wildcard__",
    "__all__",
    "*"
  ],
  "mandatoryPreflight": [
    "synchronizedRepositoryState",
    "expectedBranchState",
    "exactHeadSourceShaBinding",
    "productionEnvironmentIdentification",
    "providerAuthenticationReadiness",
    "providerPermissionReadiness",
    "targetExistence",
    "activationScopeValidity",
    "policyAllowlistMembership",
    "publicationPermissionState",
    "commercialDeliveryPermissionState",
    "rollbackPathAvailability",
    "idempotencyKeyAvailability",
    "evidenceSinkAvailability",
    "productionMutationBound",
    "environmentSafetyCondition",
    "currentSoldSamplePolicyBinding",
    "trackBDecisionBinding",
    "rightsCensusBinding",
    "providerOperatingStateBinding",
    "naturalRunWindowBinding",
    "sloErrorBudgetBinding",
    "pitrRollbackBinding",
    "programOwnerApprovalBinding"
  ],
  "mandatoryEvidence": [
    "a15-global-autonomous-policy",
    "a16-execution-control",
    "a17-bounded-live-adapter-readiness",
    "a18-autonomous-acquisition-scale",
    "a19-productization-gap",
    "a20-product-readiness-monetization",
    "a21-intelligence-product-pipeline",
    "a22-publication-control",
    "a23-commercial-delivery-channel-control",
    "beta-reliability-track-b-decision",
    "field-level-rights-census",
    "active-provider-and-adapter-receipt",
    "30-natural-runs-over-at-least-7-days",
    "slo-and-error-budget-receipt",
    "pitr-and-rollback-receipts",
    "explicit-program-owner-approval-receipt"
  ],
  "mandatoryVerification": [
    "policyDecision",
    "preflightDecision",
    "evidenceDecision",
    "rollbackDecision",
    "idempotencyDecision",
    "environmentDecision"
  ],
  "rollbackRequired": true,
  "boundedMutationRequired": true,
  "nonInteractiveRequired": true,
  "failClosedRequired": true,
  "providerBoundaryRequired": true,
  "publicationBoundaryRequired": true,
  "commercialBoundaryRequired": true,
  "productionEnvironmentRequired": true,
  "activationWindowRequired": true,
  "idempotencyRequired": true,
  "auditEvidenceRequired": true,
  "activationScopeClasses": {
    "READ_ONLY": {
      "description": "No state mutation. Read operations only.",
      "mutationAllowed": false,
      "productionAllowed": false
    },
    "INTERNAL_ONLY": {
      "description": "Internal non-production scope. No implicit promotion to BOUNDED_PRODUCTION.",
      "mutationAllowed": false,
      "productionAllowed": false,
      "note": "INTERNAL_ONLY does NOT implicitly promote to BOUNDED_PRODUCTION under any condition."
    },
    "BOUNDED_PRODUCTION": {
      "description": "Legacy bounded class; it cannot satisfy the current Production policy and grants no execution authority.",
      "mutationAllowed": false,
      "productionAllowed": false,
      "requiresRollback": true,
      "requiresEvidence": true,
      "requiresIdempotency": true
    },
    "PRODUCTION_READINESS": {
      "description": "Decision receipt only after the canonical PRODUCTION_READINESS and PRODUCTION gates pass.",
      "mutationAllowed": false,
      "productionAllowed": false,
      "separateProtectedExecutionRequired": true
    },
    "EXTERNAL_PUBLICATION": {
      "description": "Controlled external publication path. Requires A22 clearance.",
      "mutationAllowed": false,
      "productionAllowed": false,
      "requiresA22Clearance": true
    },
    "COMMERCIAL_DELIVERY": {
      "description": "Monetized commercial delivery channel. Requires A23 clearance.",
      "mutationAllowed": false,
      "productionAllowed": false,
      "requiresA23Clearance": true
    }
  },
  "boundedMutationPolicy": {
    "maxRowsAffected": 10000,
    "maxObjectsAffected": 500,
    "maxWriteBatchSize": 100,
    "maxExecutionDurationSeconds": 300,
    "maxRetryCount": 3,
    "maxProviderCalls": 0,
    "maxExternalPublications": 0,
    "maxCommercialDeliveries": 0,
    "unknownBoundsDenyByDefault": true
  },
  "invariants": {
    "policyBeforeExecution": true,
    "preflightBeforeMutation": true,
    "nonInteractiveByDefault": true,
    "failClosedOnUnknownState": true,
    "noImplicitPromotionFromInternalToBoundedProduction": true,
    "noUnrestrictedProductionMutation": true,
    "noProviderProcurement": true,
    "noProviderCredentialConsumptionOrStorage": true,
    "noBillingMutation": true,
    "noExternalPublicationMutation": true,
    "noIrreversibleCommercialTransaction": true,
    "evidenceProducedForEveryEvaluation": true,
    "idempotentEvaluation": true,
    "deterministicOutput": true,
    "rollbackCertifiedBeforeActivation": true,
    "a15ThroughA23EvidenceRequired": true,
    "providerRequiredProductsRemainProviderBlocked": true,
    "a22BlockedProductsRemainPublicationBlocked": true,
    "a23BlockedProductsRemainCommercialBlocked": true,
    "noA19A20BypassAllowed": true,
    "noInferredEvidencePass": true,
    "noCanaryOrControlToProductionPromotion": true,
    "exactHeadEvidenceRequired": true,
    "currentSoldCanonicalPolicyDigestRequired": true,
    "trackBEffectiveNExactCpCoverageConcentrationRequired": true,
    "rightsAndProviderCurrentRegistryRequired": true,
    "thirtyNaturalRunsOverAtLeastSevenDaysRequired": true,
    "sloErrorBudgetPitrRollbackRequired": true,
    "programOwnerApprovalRequired": true,
    "a24PerformsNoProductionMutation": true,
    "productionAuthorityHardDisabledPendingSignedArchiveConsumer": true,
    "technicalReadinessNeverGrantsProductionAuthority": true
  },
  "governanceBindings": {
    "currentSoldSamplePolicy": "coordination/kidults/source-intelligence/current-sold-sample-governance-v1.json",
    "currentSoldAlignment": "coordination/kidults/governance/current-sold-sample-governance-alignment-v1.json",
    "fieldLevelRightsManifest": "coordination/kidults/governance/field-level-rights-release-manifest-v1.json",
    "providerOperatingState": "coordination/kidults/registry/provider/records/provider-operating-state-v1.json",
    "requiredSampleTier": "BETA_RELIABILITY",
    "requiredNaturalRuns": 30,
    "requiredWindowDays": 7,
    "requestedClaim": "PRODUCTION"
  }
}
