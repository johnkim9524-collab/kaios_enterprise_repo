{
  "schemaVersion": "1.5.0",
  "policy": "FAIL_CLOSED_NO_SYNTHETIC_MARKET_EVIDENCE",
  "requiredPrimitives": [
    "IDENTITY",
    "SCARCITY",
    "TRANSACTION_PRICE_COMPARABLE",
    "LIQUIDITY",
    "DEMAND_ATTENTION",
    "CANON_CULTURAL_STRENGTH",
    "RISK_CONFIDENCE"
  ],
  "providerEvidence": {
    "environmentVariable": null,
    "optionalSnapshotFiles": [
      "reports/kidult100-right-data/open-evidence-latest.json",
      "reports/kidult100-right-data/wikimedia-demand-evidence-latest.json",
      "reports/kidult100-right-data/canon-evidence-latest.json",
      "reports/kidult100-right-data/validated-provider-evidence-latest.json",
      "reports/kidult100-right-data/scarcity-materialized-evidence-latest.json"
    ],
    "acceptedEvidenceClasses": [
      "AUTHORITATIVE_IDENTITY_PROVENANCE",
      "TRANSACTION_MARKET_EVIDENCE",
      "INDEPENDENT_VERIFICATION",
      "DEMAND_CULTURAL_SIGNAL",
      "CANON_REFERENCE_EVIDENCE",
      "DERIVED_INTERNAL_CONFIDENCE"
    ],
    "requiredFields": [
      "candidateKey",
      "primitive",
      "source",
      "sourceUrl",
      "rightsClass",
      "observedAt",
      "payloadHash",
      "evidenceClass"
    ],
    "marketEvidenceMustPassProviderContract": true
  },
  "canonEvidencePolicy": {
    "evidenceClass": "CANON_REFERENCE_EVIDENCE",
    "requiredPrimitive": "CANON_CULTURAL_STRENGTH",
    "allowedSignalTypes": [
      "INSTITUTIONAL_RECOGNITION",
      "REFERENCE_CANON_SIGNAL"
    ],
    "normalizedScoreAllowed": false,
    "requiresPreservedRightsClass": true,
    "requiresPreservedProvenance": true
  },
  "confidenceModel": {
    "version": "RISK_CONFIDENCE_V1",
    "minimumScoreToAssertPrimitive": 0.75,
    "weights": {
      "provenance": 0.3,
      "rightsClassification": 0.2,
      "semanticRelevance": 0.25,
      "sourceClass": 0.15,
      "freshness": 0.1
    }
  },
  "openEvidencePolicy": {
    "allowedRightsClasses": [
      "CC0_STRUCTURED_DATA",
      "CC0_WIKIMEDIA_ANALYTICS_DATA"
    ],
    "scarcity": {
      "wikidataProperty": "P1092",
      "label": "total produced",
      "allowInferredScarcityScore": false
    },
    "demandAttention": {
      "unitsSoldProperty": "P2664",
      "allowCulturalAttentionProxy": true,
      "minimumSitelinksForCulturalAttentionProxy": 3,
      "wikimediaAnalyticsPageviewProxyAllowed": true,
      "wikimediaAnalyticsLicenseRequired": "CC0-1.0",
      "culturalAttentionProxyIsMarketDemand": false
    }
  },
  "marketEvidenceDefinition": {
    "requires": [
      "TRANSACTION_PRICE_COMPARABLE",
      "LIQUIDITY"
    ],
    "syntheticOrEstimatedTransactionEvidenceAllowed": false,
    "listingPriceAsTransactionAllowed": false,
    "validatedProviderContractRequired": true
  }
}
