{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaios.kidults.com/schema/health-status.schema.json",
  "title": "KAIOS Health Status",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "checked_at",
    "status",
    "checks"
  ],
  "properties": {
    "checked_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "operational",
        "degraded",
        "failed"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "ok"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "ok": {
            "type": "boolean"
          }
        }
      }
    }
  }
}