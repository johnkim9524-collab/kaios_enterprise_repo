# Repository contracts, workflows, fixtures, and digest-bound JSON must have
# identical bytes on Linux, macOS, and Windows checkouts.
* text=auto eol=lf

# Preserve binary artifacts byte-for-byte.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
