                  "token.actions.githubusercontent.com:sub": [
                    {
                      "Fn::Sub": "repo:${GitHubRepository}:environment:${FinalizerEnvironment}:workflow_ref:${TrackWorkflowRef}"
                    },
                    {
                      "Fn::Sub": "repo:${GitHubRepository}:environment:${FinalizerEnvironment}:workflow_ref:${KpmoWorkflowRef}"
                    },
