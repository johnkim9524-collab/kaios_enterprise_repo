{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "STAGING protected broker with isolated durable RESUME dispatch ledger; exact Owner-authorized bootstrap required.",
  "Parameters": {
    "GitHubAppId": {
      "Type": "String",
      "AllowedPattern": "^[0-9]+$"
    },
    "GitHubInstallationId": {
      "Type": "String",
      "AllowedPattern": "^[0-9]+$"
    },
    "GitHubPrivateKeySecretArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:secretsmanager:ap-northeast-2:[0-9]{12}:secret:[A-Za-z0-9/_+=.@-]+$"
    },
    "GitHubRepositoryId": {
      "Type": "String",
      "AllowedPattern": "^[0-9]+$"
    },
    "FinalizerRoleName": {
      "Type": "String",
      "Default": "kidults-autonomous-finalizer-staging-role"
    },
    "GitHubRepository": {
      "Type": "String",
      "Default": "johnkim9524-collab/kaios_enterprise_repo"
    },
    "GitHubOidcProviderArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:iam::[0-9]{12}:oidc-provider/token\\.actions\\.githubusercontent\\.com$"
    },
    "FinalizerEnvironment": {
      "Type": "String",
      "Default": "KIDULTS-AUTONOMOUS-FINALIZER"
    },
    "TrackWorkflowRef": {
      "Type": "String",
      "Default": "johnkim9524-collab/kaios_enterprise_repo/.github/workflows/kidults-autonomous-track-authorization-v1.yml@refs/heads/main"
    },
    "KpmoWorkflowRef": {
      "Type": "String",
      "Default": "johnkim9524-collab/kaios_enterprise_repo/.github/workflows/kidults-autonomous-kpmo-authorization-v1.yml@refs/heads/main"
    },
    "VerifierWorkflowRef": {
      "Type": "String",
      "Default": "johnkim9524-collab/kaios_enterprise_repo/.github/workflows/kidults-autonomous-independent-verification-authorization-v1.yml@refs/heads/main"
    },
    "DispatcherEnvironment": {
      "Type": "String",
      "Default": "KIDULTS-AUTONOMOUS-DISPATCHER"
    },
    "DispatcherWorkflowRef": {
      "Type": "String",
      "Default": "johnkim9524-collab/kaios_enterprise_repo/.github/workflows/kidults-autonomous-dispatcher-v1.yml@refs/heads/main"
    },
    "ResumeActivationRunFloor": {
      "Type": "String",
      "Default": "0",
      "AllowedPattern": "^(0|[1-9][0-9]{0,19})$"
    }
  },
  "Resources": {
    "BrokerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "kidults-autonomous-event-broker-staging-role",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "read-exact-app-key",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "GitHubPrivateKeySecretArn"
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "resume-exact-namespace",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ResumeOperationTable",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "RESUME_OPERATION_V1#*",
                        "RESUME_TUPLE_V1#*"
                      ]
                    },
                    "Null": {
                      "dynamodb:LeadingKeys": "false"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "BrokerFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "kidults-autonomous-event-token-broker-staging",
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "BrokerRole",
            "Arn"
          ]
        },
        "Timeout": 180,
        "MemorySize": 128,
        "Code": {
          "ZipFile": "'use strict';\nconst source=require('node:zlib').gunzipSync(Buffer.from('','base64'),{maxOutputLength:69758});\nif(require('node:crypto').createHash('sha256').update(source).digest('hex')!=='17c8a084f5ece62ee6765de43df6990518159acda7213772bda045ebc63c1cc6')throw Error('BROKER_BUNDLE_DIGEST_MISMATCH');\nnew Function('require','exports',source.toString('utf8'))(require,exports);\n"
        },
        "Environment": {
          "Variables": {
            "GITHUB_APP_PRIVATE_KEY_SECRET_ARN": {
              "Ref": "GitHubPrivateKeySecretArn"
            },
            "GITHUB_APP_ID": {
              "Ref": "GitHubAppId"
            },
            "GITHUB_APP_INSTALLATION_ID": {
              "Ref": "GitHubInstallationId"
            },
            "GITHUB_REPOSITORY_ID": {
              "Ref": "GitHubRepositoryId"
            },
            "GITHUB_REPOSITORY": {
              "Ref": "GitHubRepository"
            },
            "RESUME_OPERATION_TABLE": {
              "Ref": "ResumeOperationTable"
            },
            "RESUME_ACTIVATION_RUN_FLOOR": {
              "Ref": "ResumeActivationRunFloor"
            }
          }
        }
      }
    },
    "EventBrokerInvokerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "kidults-autonomous-event-broker-invoker-staging-role",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubOidcProviderArn"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": [
                    {
                      "Fn::Sub": "repo:${GitHubRepository}:environment:${DispatcherEnvironment}:workflow_ref:${DispatcherWorkflowRef}"
                    },
                    {
                      "Fn::Sub": "repo:${GitHubRepository}:environment:${FinalizerEnvironment}:workflow_ref:${TrackWorkflowRef}"
                    },
                    {
                      "Fn::Sub": "repo:${GitHubRepository}:environment:${FinalizerEnvironment}:workflow_ref:${KpmoWorkflowRef}"
                    },
                    {
                      "Fn::Sub": "repo:${GitHubRepository}:environment:${FinalizerEnvironment}:workflow_ref:${VerifierWorkflowRef}"
                    }
                  ]
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "invoke-exact-event-broker",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "lambda:InvokeFunction"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "BrokerFunction",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ResumeOperationTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "kidults-autonomous-resume-staging-ledger",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    }
  },
  "Outputs": {
    "BrokerFunctionName": {
      "Value": {
        "Ref": "BrokerFunction"
      }
    },
    "BrokerFunctionArn": {
      "Value": {
        "Fn::GetAtt": [
          "BrokerFunction",
          "Arn"
        ]
      }
    },
    "EventBrokerInvokerRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "EventBrokerInvokerRole",
          "Arn"
        ]
      }
    },
    "ResumeOperationTableName": {
      "Value": {
        "Ref": "ResumeOperationTable"
      }
    }
  }
}
