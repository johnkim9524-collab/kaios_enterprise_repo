KAIOS_ENVIRONMENT=staging
KAIOS_PRODUCTION_PROMOTION_AUTHORIZED=false
KAIOS_STAGING_TENANT_ID=replace-with-bounded-tenant-id
KAIOS_POSTGRES_DSN=postgresql://kaios_runtime_app:replace-password@127.0.0.1:5432/kaios_runtime?sslmode=require
KAIOS_POSTGRES_QUERY_TIMEOUT_MS=10000
PGCONNECT_TIMEOUT=5
KAIOS_STAGING_VIEWER_TOKEN_FILE=/etc/intelligence-holdings/staging/viewer.token
KAIOS_STAGING_OPERATOR_TOKEN_FILE=/etc/intelligence-holdings/staging/operator.token
KAIOS_AUTO_START_STAGING_RUNTIME=false
