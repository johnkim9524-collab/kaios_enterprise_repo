{
  "name": "kaios-enterprise-validation",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "agent:bootstrap": "node scripts/governance/bootstrap-ai-agent-from-github-v1.mjs",
    "verify:agent-bootstrap": "node scripts/governance/verify-ai-agent-bootstrap-receipt-v1.mjs",
    "validate:agent-bootstrap": "node scripts/governance/validate-ai-agent-github-bootstrap-v1.mjs",
    "validate:market-event": "node scripts/kidults/poc/validate-market-event-schema-v1.mjs",
    "validate:control-plane": "npm --prefix services/kidults-control-plane run validate && npm --prefix services/kidults-control-plane test",
    "build:control-tower": "node scripts/kidults/kpmo/build-management-control-tower-snapshot-v1.mjs",
    "validate:control-tower": "node scripts/kidults/kpmo/validate-management-control-tower-snapshot-v1.mjs",
    "test:source-eligibility-receipt": "node --test tests/kidults/source-intelligence/source-eligibility-receipt-v1.test.mjs",
    "validate:p0-control-plane-closure": "node scripts/kidults/kpmo/run-p0-control-plane-closure-suite-v1.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
