{
  "name": "@kaios/kidults-enterprise-staging",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backup": "node operations.mjs backup",
    "build:intelligence": "node scripts/build-intelligence.mjs",
    "build:operations": "node scripts/build-operations.mjs",
    "build:sprint21": "npm run build:intelligence && npm run build:operations",
    "build:sprint22": "npm run build:sprint21 && npm test",
    "export:conversions": "node operations.mjs export-conversions",
    "notify:once": "node operations-notify.mjs once",
    "notify:watch": "node operations-notify.mjs watch",
    "refresh": "node operations.mjs refresh",
    "quality:evaluate": "node quality-alerts.mjs evaluate",
    "quality:restore": "node quality-alerts.mjs restore-last-good",
    "retention": "node operations.mjs enforce-retention",
    "start": "node server.mjs",
    "status": "node operations.mjs status",
    "test": "node --test server.test.mjs operations.test.mjs collector-evidence.test.mjs quality-alerts.test.mjs operations-notify.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
