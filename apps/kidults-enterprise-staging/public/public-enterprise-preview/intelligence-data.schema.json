{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kidults.com/schemas/intelligence-data.schema.json",
  "title": "KIDULTS Unified Intelligence Data Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "label",
    "updated",
    "methodologyVersion",
    "headline",
    "trend",
    "categoriesData",
    "signalMix",
    "confidenceDistribution",
    "sourceComposition",
    "geography",
    "movers",
    "lifecycle",
    "correlation"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["illustrative", "staging", "validated", "production"]
    },
    "label": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "format": "date-time" },
    "methodologyVersion": { "type": "string", "pattern": "^v[0-9]+(?:\\.[0-9]+){1,2}$" },
    "headline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kidult100",
        "change30d",
        "confidence",
        "coverageBrands",
        "sourceFamilies",
        "categories",
        "sentiment",
        "canonStrength",
        "marketVelocity",
        "activeListings"
      ],
      "properties": {
        "kidult100": { "$ref": "#/$defs/score" },
        "change30d": { "type": "number", "minimum": -100, "maximum": 100 },
        "confidence": { "$ref": "#/$defs/percentage" },
        "coverageBrands": { "type": "integer", "minimum": 0 },
        "sourceFamilies": { "type": "integer", "minimum": 0 },
        "categories": { "type": "integer", "minimum": 0 },
        "sentiment": { "$ref": "#/$defs/score" },
        "canonStrength": { "$ref": "#/$defs/score" },
        "marketVelocity": { "type": "number", "minimum": 0 },
        "activeListings": { "type": "integer", "minimum": 0 }
      }
    },
    "trend": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["period", "value"],
        "properties": {
          "period": { "type": "string", "minLength": 1 },
          "value": { "$ref": "#/$defs/score" }
        }
      }
    },
    "categoriesData": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "score", "confidence", "state", "velocity", "liquidity"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "score": { "$ref": "#/$defs/score" },
          "confidence": { "$ref": "#/$defs/percentage" },
          "state": {
            "type": "string",
            "enum": ["Accelerating", "Monitor", "Weakening", "Stable", "Emerging"]
          },
          "velocity": { "type": "number", "minimum": 0 },
          "liquidity": { "$ref": "#/$defs/percentage" }
        }
      }
    },
    "signalMix": { "$ref": "#/$defs/namedPercentageArray" },
    "confidenceDistribution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["grade", "value"],
        "properties": {
          "grade": { "type": "string", "enum": ["A", "B", "C", "D"] },
          "value": { "$ref": "#/$defs/percentage" }
        }
      }
    },
    "sourceComposition": { "$ref": "#/$defs/namedPercentageArray" },
    "geography": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region", "value"],
        "properties": {
          "region": { "type": "string", "minLength": 1 },
          "value": { "$ref": "#/$defs/percentage" }
        }
      }
    },
    "movers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "change"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "change": { "type": "number", "minimum": -100, "maximum": 100 }
        }
      }
    },
    "lifecycle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "stage", "score"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "enum": ["Emerging", "Growth", "Mature", "Legacy"] },
          "score": { "$ref": "#/$defs/score" }
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "values"],
      "properties": {
        "labels": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "values": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
    "namedPercentageArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "$ref": "#/$defs/percentage" }
        }
      }
    }
  }
}
