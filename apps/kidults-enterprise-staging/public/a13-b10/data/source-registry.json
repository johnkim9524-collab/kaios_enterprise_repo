      "endpoint": "/a13-b10/data/intelligence-product.json",
      "healthEndpoint": null,
      "enabled": true,
      "priority": 100,
      "trust": "illustrative",
      "provenance": {
        "sourceFamilies": 42,
        "brandsCovered": 500,
        "categoriesCovered": 12,
        "confidenceModel": "Source diversity × recency × reconciliation × anomaly control"
      }
    }
  ]
