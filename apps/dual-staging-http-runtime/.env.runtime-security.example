# Required by the fail-closed dual staging runtime.
KAIOS_STAGING_RUNTIME_DATA_DIR=/opt/intelligence-holdings/staging/runtime-data
KAIOS_STAGING_VIEWER_SUBJECT=viewer
KAIOS_STAGING_OPERATOR_SUBJECT=operator

# Existing staging-only invariants.
KAIOS_ENVIRONMENT=staging
KAIOS_PRODUCTION_PROMOTION_AUTHORIZED=false

# Keep token values out of this file. Point to root/service-owned token files.
KAIOS_STAGING_VIEWER_TOKEN_FILE=/etc/intelligence-holdings/staging/viewer.token
KAIOS_STAGING_OPERATOR_TOKEN_FILE=/etc/intelligence-holdings/staging/operator.token
