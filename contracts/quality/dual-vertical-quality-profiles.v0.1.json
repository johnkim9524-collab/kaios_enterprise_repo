    "market_signal_quality_inputs": ["evidence_count", "source_coverage", "confidence_score", "duplicate_evidence_count"],
    "premium_surface_minimum_score": 70,
    "invalid_negative_price": "quarantine",
    "large_price_outlier": "review_or_reject"
  },
  "artfund": {
    "required_transaction_fields": ["artwork_id", "auction_lot_id", "transaction_date", "currency", "evidence_hash"],
    "transaction_quality_inputs": ["evidence_count", "source_coverage", "confidence_score", "provenance_completeness", "provenance_disputed"],
    "premium_surface_minimum_score": 70,
    "disputed_provenance": "quarantine",
